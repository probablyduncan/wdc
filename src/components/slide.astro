---
import "../css.css";
import { getPageInfo, getPageName } from "../lib/slides.server";

const pageInfo = getPageInfo(getPageName(Astro.url));
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="text-scale" content="scale" />

        <link rel="canonical" href={Astro.site} />
        <title>WDC, DP, you see</title>
        <script src="../lib/slides.client.ts" />
    </head>

    <body data-page-info={JSON.stringify(pageInfo)}>
        <header>
            <span>wdc/2026</span>
            <span>1/25</span>
        </header>
        <main>
            <slot />
        </main>
        <footer>
            <!-- <span data-slide-counter>{getSlideCounter(slide)}</span> -->
            <span>duncanpetrie</span>
            <span>
                <button data-prev-slide>prev</button>
                &nbsp;/&nbsp;
                <button data-next-slide>next</button>
            </span>
        </footer>
    </body>

    <style>
        body {
            margin: unset;
        }

        main {
            width: 100vw;
            height: 100vh;

            display: flex;
            place-content: center;
            place-items: center;
        }

        header,
        footer {
            position: fixed;
            left: 0;
            right: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;

            line-height: 1;
            padding: 0 1rem;

            font-variant-numeric: diagonal-fractions;
            font-variant-caps: petite-caps;
        }

        header {
            top: 0;
        }

        footer {
            bottom: 0;
        }
    </style>
</html>
