---
import "../../src/css.css";
import {
    numSlides,
    slides,
    getSlideByPathname,
    getSlideCounter,
} from "../slides";

const slide = getSlideByPathname(Astro.originPathname);
if (!slide) throw "no slide!";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="text-scale" content="scale" />

        <link rel="canonical" href={Astro.site} />
        <title>WDC, DP, you see</title>
    </head>

    <body>
        <header>
            <span>DUNCAN</span>
            <span>WDC</span>
            <span>2026</span>
        </header>
        <main>
            <slot />
        </main>
        <footer class="tnum">
            <span data-slide-counter>{getSlideCounter(slide)}</span>
            <button data-slide-toggle="prev">prev</button>
            <button data-slide-toggle="next">next</button>
        </footer>
    </body>

    <style>
        body {
        }

        main {
            max-width: 100vw;
            height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        header,
        footer {
            position: fixed;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
        }

        header {
            top: 0;
        }

        footer {
            bottom: 0;
        }
    </style>

    <script>
        import {
            numSlides,
            slides,
            getSlideByPathname,
            getSlideCounter,
            type Slide,
        } from "../slides";

        function initSlides() {
            type SlideDirection = "prev" | "next";
            let currentSlide = getSlideByPathname(location.pathname)!;
            if (!currentSlide) return;

            const updateSlideNumbers = (() => {
                const slideNumberContainers = [
                    ...document.querySelectorAll("[data-slide-counter]"),
                ] as HTMLElement[];

                return () =>
                    slideNumberContainers.forEach((el) => {
                        el.innerText = getSlideCounter(
                            currentSlide,
                            el.dataset.slideCounter,
                        );
                    });
            })();

            // set up toggles
            document
                .querySelectorAll(
                    "[data-slide-toggle=prev], [data-slide-toggle=next]",
                )
                .forEach((_el) => {
                    const el = _el as HTMLElement;
                    el.addEventListener("click", () => {
                        go(el.dataset.slideToggle as SlideDirection);
                    });
                });

            document.addEventListener("keydown", (e) => {
                switch (e.key) {
                    case "ArrowLeft":
                        go("prev");
                        break;
                    case "ArrowRight":
                        go("next");
                        break;
                }
            });

            function go(dir: SlideDirection, instant: boolean = false) {

                // get out when we're at start or end
                // remove this when we need to skip/revert animations
                if (
                    (currentSlide.index === slides.length - 1 &&
                        dir === "next") ||
                    (currentSlide.index === 0 && dir === "prev")
                ) {
                    return;
                }

                // if going to prev page, just need to get there
                if (dir === "prev" && currentSlide.type === "server") {
                    window.location.href = "/" + slides.slice(0, currentSlide.index).findLast(s => s.type === "server")?.name;
                    return;
                }

                currentSlide =
                    slides[currentSlide.index + (dir === "next" ? 1 : -1)];
                updateSlideNumbers();

                if (currentSlide.type === "server") {
                    window.location.href = "/" + currentSlide.name;
                    return;
                }

                // @ts-ignore
                window[currentSlide.name]();
            }
        }

        document.addEventListener("DOMContentLoaded", initSlides);
    </script>
</html>
