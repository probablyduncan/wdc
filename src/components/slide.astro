---
import "../css.css";

interface Props {
    next?: string;
    prev?: string;
}

const { next, prev } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="text-scale" content="scale" />

        <link rel="canonical" href={Astro.site} />
        <title>DP@WDC</title>
        <script src="../lib/slides.ts"></script>
    </head>

    <body data-next-page={next} data-prev-page={prev}>
        <main>
            <slot />
        </main>
    </body>

    <style>
        body {
            margin: unset;
        }

        main {
            width: 100vw;
            height: 100vh;

            display: flex;
            flex-flow: column;
            place-content: center;
            place-items: center;
        }
    </style>
</html>
