---
import "../css.css";
import { getSlides, getPageName } from "../lib/slides.server";

const slides = getSlides();
const thisPage = getPageName(Astro.url);

const thisPageIndex = slides.findIndex((s) => s.name === thisPage && s.type === "page",);
const nextPageIndex = slides.slice(thisPageIndex + 1).findIndex((s) => s.type === "page");
const nextPage = nextPageIndex > -1 ? slides[nextPageIndex + thisPageIndex + 1].name : "";
const prevPage = slides.slice(0, thisPageIndex).findLast((s) => s.type === "page")?.name ?? "";
const transitions = slides.slice(thisPageIndex + 1, nextPageIndex > -1 ? nextPageIndex + thisPageIndex + 1 : undefined).map(s => s.name);

// but I guess really what I need is info for the current page only:
// current page's transitions
// next page
// prev page
// so a flat array of everything isn't really helpful
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="text-scale" content="scale" />

        <link rel="canonical" href={Astro.site} />
        <title>WDC, DP, you see</title>
    </head>

    <body
        data-this-page={thisPage}
        data-next-page={nextPage}
        data-prev-page={prevPage}
        data-transitions={JSON.stringify(transitions)}
    >
        <header>
            <span>DUNCAN</span>
            <span>WDC</span>
            <span>2026</span>
        </header>
        <main>
            <slot />
        </main>
        <footer class="tnum">
            <!-- <span data-slide-counter>{getSlideCounter(slide)}</span> -->
            <button data-slide-toggle="prev">prev</button>
            <button data-slide-toggle="next">next</button>
        </footer>
    </body>

    <style>
        body {
        }

        main {
            max-width: 100vw;
            height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        header,
        footer {
            position: fixed;
            left: 0;
            right: 0;
            display: flex;
            justify-content: space-between;
        }

        header {
            top: 0;
        }

        footer {
            bottom: 0;
        }
    </style>

    <script>
        function initSlides() {
            console.log(document.body.dataset.thisPage);
            console.log(document.body.dataset.nextPage);
            console.log(document.body.dataset.prevPage);
            console.log(JSON.parse(document.body.dataset.transitions ?? "[]"));
        }

        document.addEventListener("DOMContentLoaded", initSlides);
    </script>
</html>
