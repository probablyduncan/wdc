<style>
    #pointer-section {
        position: fixed;
        inset: 0;
        &:not(.active) {
            display: none;
        }
    }

    #woo, .woo {
        font-family: Charlottenburg;
        color: tomato;
        font-size: 5vh;
        text-align: left;
        writing-mode: vertical-lr;
        height: 100%;

        user-select: none;

        /* &:not(.active) {
            display: none;
        } */

        :last-child {
            cursor: grab;
        }
    }

    #char-map {
        font-family: Charlottenburg;
        font-size: 5vh;
        opacity: 0;
        visibility: hidden;
        height: 0;
    }
</style>
<script>
    import AnimationFrameController from "../lib/animationFrameController";
    import { SpringController } from "../lib/interpolationController";
    import {
        registerClassTransition,
        registerTransition,
        withPrevious,
    } from "../lib/slides";

    registerClassTransition("#charlottenburg-section");
    withPrevious();

    registerClassTransition("#kilotype-figure");
    withPrevious();

    registerClassTransition("#kilotype-figure", "active", "remove");
    registerClassTransition("#woo");
    withPrevious();

    const woo = document.getElementById("woo")!;
    const anchor = woo.querySelector<HTMLSpanElement>("span:first-child")!;
    const weight = woo.querySelector<HTMLSpanElement>("span:last-child")!;

    const sizeMap: Record<string, number> = {};
    document
        .getElementById("char-map")
        ?.querySelectorAll("span")
        .forEach((e) => {
            e.getBoundingClientRect();
            sizeMap[e.innerHTML.trim()] = e.getBoundingClientRect().width;
        });

    const coils = [
        ...woo.querySelectorAll<HTMLSpanElement>(
            "span:not(:first-child, :last-child)",
        ),
    ].map((el) => {
        const upper = el.innerText.toUpperCase();
        const lower = el.innerText.toLowerCase();
        const current: "upper" | "lower" =
            el.innerText === upper ? "upper" : "lower";

        return {
            el,
            text: {
                upper,
                lower,
            },
            current,
        };
    });

    const expandedWidth = sizeMap["O"] * coils.length;
    const contractedWidth = sizeMap["o"] * coils.length;
    const stretchWidth = expandedWidth - contractedWidth;
    const widthDifference = sizeMap["O"] - sizeMap["o"];

    // current is where the mouse is dragging the weight
    // target is equilibrium, which is halfway between all contracted and all expanded?
    // start is 0,
    // 
    
    const x = new SpringController({
        damping: 10,
    });

    let start: number = 0;
    let grabbing: boolean = false;

    weight.addEventListener("mousedown", (e) => {
        anchor.style.cursor = "grabbing";
        grabbing = true;
        start = e.clientY;
        const abortController = new AbortController();
        window.addEventListener(
            "mouseup",
            () => {
                grabbing = false;
                start = 0;
                abortController.abort();
                anchor.style.cursor = "grab";
            },
            { signal: abortController.signal },
        );
        window.addEventListener(
            "mousemove",
            (e) => {
                x.current = Math.max(Math.min(e.clientY - start, stretchWidth / 2), stretchWidth / -2);
            },
            { signal: abortController.signal },
        );
    });

    const wooController = new AnimationFrameController(({ deltaMS }) => {
        if (!grabbing) {
            x.step(deltaMS);
        }
        console.log(x.current);

        x.current + 
        
        // figure out the number that needs to be expanded?
        // 

        return true;
    });

    registerTransition({
        begin() {
            wooController.playIfPaused();
        },
        revert() {
            wooController.pause();
        },
    });
    withPrevious();

    registerTransition({
        begin() {
            wooController.pause();
        },
        revert() {
            wooController.playIfPaused();
        },
    });
</script>
