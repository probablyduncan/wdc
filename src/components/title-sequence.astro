<style>
    body {
        overflow: clip;
    }

    #title {
        h2 {
            font-size: 5vw;
            line-height: 0.7;
            margin-top: calc(50vh - 1em);
            margin-bottom: 0;
        }
        h3 {
            font-size: 2vw;
            text-align: center;
        }

        &.invisible {
            opacity: 0;
        }

        &.gone {
            display: none;
        }
    }

    footer {
        position: fixed;
        bottom: 2em;
        left: 4ch;
        text-align: justify;
        /* width: 20ch; */
    }

    #googling-website {
        width: min(80vw, 100vh);
        position: fixed;
        img {
            width: 100%;
            &:not(.active) {
                display: none;
            }
        }
    }

    #cern {
        font-family: "Times New Roman", Times, serif;
        width: 100vw;
        min-height: 100svh;
        transform-origin: top left;
        padding: 1em 0.5em;
        transition-timing-function: linear(
            0,
            0.029 1.3%,
            0.119 2.8%,
            0.659 8.7%,
            0.871 11.6%,
            1.009 14.6%,
            1.052 16.2%,
            1.078 17.9%,
            1.088 19.7%,
            1.085 21.7%,
            1.014 31.4%,
            0.993 38%,
            1.001 57.6%,
            1
        );
        h1 {
            margin-top: 0;
        }
        a {
            color: blue;
            color: #1200ee;
            text-decoration: underline;
            cursor: pointer;
            &.visited {
                color: purple;
                color: #551a8b;
            }
        }

        &.centered {
            translate: calc(50vw - 14ch);
            font-size: 2em;
        }

        &.inter {
            font-family:
                "Inter",
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Oxygen,
                Ubuntu,
                Cantarell,
                "Open Sans",
                "Helvetica Neue",
                sans-serif;
        }

        &.title-centered {
            h1 {
                position: relative;
                width: 20ch;
                text-align: center;
                transform: translate(calc(25vw), 20vh) scale(2);
                transform-origin: top left;
                width: 25vw;
                transition: transform 0.5s;
            }
        }

        &.tagline-centered {
            #tagline {
                position: relative;
                transform: translate(calc(25vw), 30vh) scale(2);
                height: 1lh;
                transition: transform 0.5s;
                transform-origin: top left;
                width: 25vw;
                text-align: center;
            }
        }

        &.colors {
            padding: 10px;
            background-image: url("/images/gradient.svg");
            background-size: cover;
            background-position: center;
            color: white;
            a {
                color: rgb(255, 219, 219);
            }
            h1 {
                background: linear-gradient(
                    100deg,
                    #fff 0%,
                    #3ddcff 20%,
                    #ff5fb0 60%,
                    #ffcf5c 80%
                );
                text-shadow: 2 2 8px rgba(255, 255, 255, 0.2);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }
        }

        &.other-crap {
            #everything-else > *:not(#tagline) {
                transform: translate(-100%, -100%);
                transition: transform 0.5s;
            }
        }

        #awwwards {
            transform: translateX(-20%);
            scale: 2;
            right: 0;
            bottom: 0;
            position: fixed;
            z-index: 999;
            &:not(.active) {
                display: none;
            }
        }

        #subway {
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 100vh;
            pointer-events: none;
            user-select: none;
        }

        &.ai-lang .ai {
            font-weight: bold;
            background: linear-gradient(
                100deg,
                #fff 0%,
                #3ddcff 20%,
                #ff5fb0 60%,
                #ffcf5c 80%
            );
            text-shadow: 2 2 8px rgba(255, 255, 255, 0.2);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        &:not(.ai-lang) {
            .ai {
                display: none;
            }
        }

        &.subway {
            h1 {
                transform: translate(calc(25vw + 100vh * 124 / 225 / 2), 20vh) scale(2);
            }

            #tagline {
                transform: translate(calc(25vw + 100vh * 124 / 225 / 2), 30vh) scale(2);
            }

            #subway {
                width: calc(100vh * 124 / 225);
                transition: width 0.5s;
                transition-timing-function: linear(
                    0,
                    0.029 1.3%,
                    0.119 2.8%,
                    0.659 8.7%,
                    0.871 11.6%,
                    1.009 14.6%,
                    1.052 16.2%,
                    1.078 17.9%,
                    1.088 19.7%,
                    1.085 21.7%,
                    1.014 31.4%,
                    0.993 38%,
                    1.001 57.6%,
                    1
                );
            }
        }

        &.hidden {
            display: none;
            * {
                display: none;
            }
        }
    }

    #everything-else {
        &:not(.active) {
            opacity: 0;
            user-select: none;
            pointer-events: none;
        }
    }
</style>
<script>
    import { getChildTransitions } from "../lib/codeBlockHelpers";
    import { registerClassTransition, withPrevious } from "../lib/slides";

    registerClassTransition("#everything-else");

    const googlingWebsite = getChildTransitions("googling-website", "img");
    
    googlingWebsite.next();
    googlingWebsite.next();

    googlingWebsite.hide();
    
    registerClassTransition("#title", "invisible");
    registerClassTransition("#cern", "centered", "remove");
    registerClassTransition("#title", "gone");
    withPrevious();


    // font
    registerClassTransition("#cern", "inter");
    registerClassTransition("#cern", "title-centered");
    registerClassTransition("#cern", "tagline-centered");
    registerClassTransition("#cern", "other-crap");
    registerClassTransition("#cern", "colors");
    registerClassTransition("#cern", "ai-lang");
    
    googlingWebsite.next();
    googlingWebsite.next();

    googlingWebsite.hide();
    registerClassTransition("#cern", "subway");
    withPrevious();
    
    registerClassTransition("#awwwards");

    registerClassTransition("#cern", "hidden");

    // no matter how much we do, we still can't fight the ipad kids
</script>
