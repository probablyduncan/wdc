const PIXELS_PER_FRAME = 1;
let x = 0;
let max = newHouse.offsetLeft - oldHouse.offsetLeft;

function moveEgg() {
    x = Math.min(x + PIXELS_PER_FRAME, max);    
    egg.style.translate = x + "px";

    if (x < max) {
        requestAnimationFrame(moveEgg);
    }
}
requestAnimationFrame(moveEgg);
`}
        />
    </div>
    <div id="old-house" class="house">
        <img src="/images/house2.jpeg" />
    </div>
    <div id="new-house" class="house">
        <img src="/images/house2.jpeg" />
    </div>
    <img id="neighbor" class="house" src="/images/house1.png" />
    <div id="egg"></div>
    <!-- <div id="rewind"></div> -->
    <div id="arson-timeline">
        <img src="/images/arson-timeline.svg" />
    </div>
    <div id="raf">&nbsp;&nbsp;requestAnimationFrame!!</div>
    <img class="money" src="/images/money.png" style="--i: 0;" />
    <img class="money" src="/images/money.png" style="--i: 1;" />
    <img class="money" src="/images/money.png" style="--i: 2;" />
    <img class="money" src="/images/money.png" style="--i: 3;" />
    <img class="money" src="/images/money.png" style="--i: 4;" />
    <div id="set-interval-figures">
        <Figure src="/images/interval-bad.png" x="0.2" y="0.3">
            The defunct and forsaken browser function `setInterval`.
        </Figure>
        <Figure x={0.5} y={0.5} figure={4} src="/images/mdn-raf.png">
            The much-adored JavaScript™ function `window.requestAnimationFrame`
            became Baseline in mid 2015.[39] From MDN and the Mozilla
            Corporation. Available at <a
                href="https://developer.mozilla.org/en-US/docs/Web/API/Window/requestAnimationFrame"
                target="_blank"
                >https://developer.mozilla.org/en-US/docs/Web/API/Window/requestAnimationFrame</a
            >
        </Figure>
        <Figure
            x={0.65}
            y={0.15}
            figure={5}
            src="/images/friendship-original.jpg"
        >
            Pakistani government worker Asif Raza Rana announces he is no longer
            friends with a man named Mudasir[40] (2015). Available at: <a
                href="https://knowyourmeme.com/memes/friendship-ended-with-mudasir"
                target="_blank">https://knowyourmeme.com/memes/</a
            >
        </Figure>
        <Figure x={0.4} y={0.55} figure={6} src="/images/friendship.webp">
            Internet <i>meme</i> created by an anonymous internet user[41] exemplifies
            the widespread jubilation[42] felt by millions after `window.requestAnimationFrame`,
            the JavaScript™ function, became generally available in all browsers in
            mid-2015.[43]
        </Figure>
    </div>
</section>
<style>
    #egg-section {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: clip;
        background-color: white;
        &:not(.active) {
            opacity: 0;
            pointer-events: none;
            user-select: none;
        }
    }

    .house {
        position: fixed;
        z-index: -1;
        user-select: none;
        pointer-events: none;
        &:not(.active) {
            opacity: 0;
        }
    }

    #old-house {
        left: -5vw;
        bottom: 5vh;
        width: 50vh;

        img {
            filter: hue-rotate(-60deg) saturate(50%);
            width: 100%;
        }

        &::after {
            background-image: url("/images/house-fire.webp");
            background-size: contain;
            content: "";
            position: absolute;
            inset: 0;
            opacity: 0;
        }

        &.hot::after,
        &.fraud::after {
            opacity: 1;
            transition: opacity 10s;
        }

        &.fraud::after {
            transition-delay: 10s;
        }
    }

    #new-house {
        right: 10vw;
        bottom: 5vh;
        width: 50vh;

        img {
            width: 100%;
        }

        &.yard-egg::after {
            content: "";
            position: absolute;
            background-image: url("/images/egg.webp");
            background-size: contain;
            width: 30%;
            aspect-ratio: 1;
            left: 35%;
            top: 57%;
            animation-name: grow-egg;
            animation-delay: 24s;
            animation-timing-function: steps(50);
            animation-duration: 100s;
            animation-fill-mode: both;
            transform-origin: bottom;
        }
    }

    @keyframes grow-egg {
        from {
            transform: scale(1);
        }
        to {
            transform: scale(3);
        }
    }

    #neighbor {
        right: -10vw;
        bottom: 11.5vh;
        width: 40vh;
        &.active {
            transition: opacity 1s;
        }
    }

    #egg {
        position: fixed;
        bottom: 17.5vh;
        width: 24vh;

        aspect-ratio: 1;
        background-color: #deafaf;
        background-size: cover;

        --initial-x: 9vw;
        --x: 0px;
        translate: calc(var(--initial-x) + var(--x));

        &.unpacked {
            display: none;
        }
        &.fancy {
            background-color: bisque;
            border: 8px ridge burlywood;
        }
        &.faberge {
            background-image: url("/images/egg.webp");
        }
        &.right {
            background-image: url("/images/egg-right.webp");
            /* this isn't quite right, need to fix this with screen size */
            --x: 46.8vw;
        }
        &.cracked {
            background-image: url("/images/egg-cracked.webp");
        }
        &.hot {
            animation: crack-after-time 5s step-end both;
            background-color: rgb(251, 153, 146);
            transition:
                background-color 10s,
                border-color 10s;
            border-color: rgb(236, 138, 96);
        }
    }

    body:has(#egg.right) #code-wrapper {
        animation: shake 0.5s ease-out;
    }

    @keyframes shake {
        0% {
            rotate: 0deg;
        }
        20% {
            rotate: -10deg;
        }
        40% {
            rotate: 8deg;
        }
        60% {
            rotate: -4deg;
        }
        80% {
            rotate: 2deg;
        }
        100% {
            rotate: 0deg;
        }
    }

    @keyframes crack-after-time {
        0% {
            background-image: url("/images/egg.webp");
        }
        61% {
            background-image: url("/images/egg-cracked.webp");
        }
        100% {
            background-image: url("/images/egg-crumbled.webp");
        }
    }

    #code-wrapper {
        position: fixed;
        left: 20%;
        top: 10%;

        :global(.expressive-code):not(.active) {
            display: none;
        }

        :global(.expressive-code):not(.full-width) .code {
            max-width: 95ch;
        }
    }

    /* #rewind {
        position: fixed;
        inset: 0;
        background-image: url("/images/rewind.gif");
        background-size: cover;
        mix-blend-mode: difference;
        &:not(.active) {
            opacity: 0;
        }
    } */

    #arson-timeline {
        position: absolute;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;

        img {
            border: 4px solid black;
        }

        &:not(.active) {
            opacity: 0;
            pointer-events: none;
            user-select: none;
        }
    }

    #raf {
        position: fixed;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 4vw;
        background-color: white;
        &:not(.active) {
            display: none;
        }
    }

    .money {
        --base-delay: 20s;
        --stagger-delay: calc(var(--i, 0) * 2s);

        --amplitude: 2vh;
        --bottom: 20vh;

        position: fixed;
        width: 60px;
        aspect-ratio: 1;
        background-image: url("/images/money.png");
        background-size: contain;
        display: none;
        &.active {
            animation: money 8s linear both infinite;
            animation-delay: calc(var(--base-delay) + var(--stagger-delay));
            display: block;
        }
    }

    @keyframes money {
        0% {
            left: 5vw;
            bottom: var(--bottom);
            opacity: 0;
        }
        10%,
        30%,
        50%,
        70%,
        90% {
            bottom: calc(var(--bottom) + var(--amplitude));
        }
        25%,
        85% {
            opacity: 0.8;
        }
        20%,
        40%,
        60%,
        80% {
            bottom: var(--bottom);
        }
        100% {
            bottom: var(--bottom);
            left: 70vw;
            opacity: 0;
        }
    }
</style>
<script>
    import {
        addConstControl,
        addLiveCommentDisplay,
    } from "../lib/codeBlockHooks";
    import {
        registerClassTransition,
        registerRafTransition,
        registerTransition,
        withPrevious,
    } from "../lib/slides";

    const egg = document.getElementById("egg")!;
    const oldHouse = document.getElementById("old-house")!;
    const newHouse = document.getElementById("new-house")!;
    const neighbor = document.getElementById("neighbor")!;

    const x = addLiveCommentDisplay<number>("xpos", 0);

    function translateEgg(value: number | "unset") {
        registerTransition(() => {
            let prev: number;
            return {
                begin() {
                    prev = x.get();
                    if (value === "unset") {
                        x.set(0);
                        egg.style.removeProperty("--x");
                    } else {
                        x.set(value);
                        egg.style.setProperty("--x", x.get() + "px");
                    }
                },
                revert() {
                    if (prev) {
                        x.set(prev);
                        egg.style.setProperty("--x", x.get() + "px");
                    } else {
                        x.set(0);
                        egg.style.removeProperty("--x");
                    }
                },
            };
        });
    }

    // code block controls
    const { codeBlockTransition, nextCodeBlock, prevCodeBlock } = (() => {
        let currentCodeBlock: Element | null = null;
        function activateCurrentCodeBlock() {
            document
                .querySelectorAll("#code-wrapper > .active")
                .forEach((el) => el.classList.remove("active"));

            currentCodeBlock?.classList.add("active");
        }

        function nextCodeBlock() {
            if (currentCodeBlock) {
                currentCodeBlock = currentCodeBlock.nextElementSibling;
            } else {
                currentCodeBlock = document.querySelector(
                    "#code-wrapper .expressive-code:first-child",
                );
            }
            activateCurrentCodeBlock();
        }

        function prevCodeBlock() {
            if (currentCodeBlock) {
                currentCodeBlock = currentCodeBlock.previousElementSibling;
            } else {
                currentCodeBlock = document.querySelector(
                    "#code-wrapper .expressive-code:last-child",
                );
            }
            activateCurrentCodeBlock();
        }

        return {
            nextCodeBlock,
            prevCodeBlock,
            codeBlockTransition: () =>
                registerTransition({
                    begin: nextCodeBlock,
                    revert: prevCodeBlock,
                }),
        };
    })();

    const { beginSetInterval, endSetInterval } = (() => {
        let intervalId: NodeJS.Timeout | undefined = undefined;

        function startInterval() {
            cancelInterval();
            intervalId = setInterval(() => {
                x.set((prev) => prev + 1);
                egg.style.setProperty("--x", x.get() + "px");
            }, 1);
        }
        function cancelInterval() {
            if (intervalId) {
                clearInterval(intervalId);
                intervalId = undefined;
            }
            egg.style.removeProperty("--x");
            x.set(0);
        }

        // start setInterval
        return {
            beginSetInterval: () =>
                registerTransition({
                    begin: startInterval,
                    revert: cancelInterval,
                }),
            endSetInterval: () =>
                registerTransition({
                    begin: cancelInterval,
                    revert: startInterval,
                }),
        };
    })();

    // initial appear
    registerClassTransition("#egg-section");

    // egg appears
    registerClassTransition("#egg", "fancy");

    // houses
    registerClassTransition("#new-house");
    registerClassTransition("#old-house");

    registerClassTransition("#egg", "faberge");

    // code to translate all at once
    codeBlockTransition();
    codeBlockTransition();

    // go right all at once, break egg!
    codeBlockTransition();
    registerClassTransition("#egg", "right");
    withPrevious();

    // ok, go back
    registerClassTransition("#egg", "right", "remove");
    codeBlockTransition();
    withPrevious();

    // show new code, to translate 1px at a time
    codeBlockTransition();

    codeBlockTransition();
    translateEgg(1);
    withPrevious();

    codeBlockTransition();
    translateEgg(2);
    withPrevious();

    codeBlockTransition();
    translateEgg(3);
    withPrevious();

    codeBlockTransition();
    translateEgg(4);
    withPrevious();

    codeBlockTransition();
    translateEgg(200);
    withPrevious();

    // ok, back to drawing board
    codeBlockTransition();
    translateEgg("unset");
    withPrevious();

    // what about a while loop? start a little fire
    codeBlockTransition();
    registerClassTransition("#old-house", "hot");
    withPrevious();
    registerClassTransition("#egg", "hot");
    withPrevious();
    {
        let intervalId: NodeJS.Timeout | undefined;
        function stop() {
            if (intervalId) {
                clearInterval(intervalId);
                intervalId = undefined;
            }
            x.set(0);
        }
        function start() {
            stop();
            intervalId = setInterval(() => {
                x.set((prev) => prev + 321_739 + 7);
            }, 0);
        }

        // start increasing x with while loop
        registerTransition({
            begin: start,
            revert: stop,
        });
        withPrevious();

        // show arson timeline, stop increasing x
        registerClassTransition("#arson-timeline", "active");

        // ok enough of that
        registerClassTransition("#arson-timeline", "active", "remove");
        registerClassTransition("#old-house", "hot", "remove");
        withPrevious();
        registerClassTransition("#egg", "hot", "remove");
        withPrevious();
        codeBlockTransition();
        withPrevious();
        registerTransition({
            begin: stop,
            revert: start,
        });
        withPrevious();
    }

    // try set interval
    codeBlockTransition();
    beginSetInterval();
    withPrevious();

    // show interval figures
    document
        .querySelectorAll("#set-interval-figures > figure")
        .forEach((el) => {
            registerTransition({
                begin() {
                    el.classList.add("active");
                },
                revert() {
                    el.classList.remove("active");
                },
            });
        });

    // cancel interval, no good
    endSetInterval();
    registerClassTransition(
        "#set-interval-figures > figure",
        "active",
        "remove",
    );
    withPrevious();
    codeBlockTransition();
    withPrevious();

    // raf single console log timestamp
    registerTransition({
        begin() {
            requestAnimationFrame(() => console.log(`i’ve been framed!`));
        },
        revert() {
            // console.clear();
        },
    });
    codeBlockTransition();
    withPrevious();

    const logRafHandler = registerRafTransition(
        {},
        () => {
            console.log(`i’ve been framed on ${new Date()}!`);
            return true;
        },
        () => {
            // console.clear();
        },
    );

    logRafHandler.registerStart();
    codeBlockTransition();
    withPrevious();

    logRafHandler.registerEnd();
    codeBlockTransition();
    withPrevious();

    // building our frame loop
    codeBlockTransition();
    codeBlockTransition();
    codeBlockTransition();

    const pxPerFrame = addConstControl(
        "PIXELS_PER_FRAME",
        [-20, -10, -5, -1, 0, 1, 5, 10, 20],
        true,
    );
    let stopEggAtHouse: boolean = false;
    let stopLoopingAtHouse: boolean = false;

    const moveBoxRafHandler = registerRafTransition(
        {
            neighborLeft: neighbor.getBoundingClientRect().left,
            eggStartRight: egg.getBoundingClientRect().right,
            neighborShown: false,
        },
        ({ state }) => {
            x.set((prev) => prev + pxPerFrame.get());

            const max = Math.floor(
                state.neighborLeft - state.eggStartRight - egg.clientWidth / 2,
            );
            if (x.get() > max && stopEggAtHouse) {
                x.set(max);
            }

            if (!state.neighborShown && x.get() >= max) {
                state.neighborShown = true;
                neighbor.classList.add("active");
                pxPerFrame.show();
            }

            egg.style.setProperty("--x", x.get() + "px");
            console.log("x:", x.get());

            return !stopLoopingAtHouse || x.get() < max;
        },
        ({ event }) => {
            if (event === "revert") {
                egg.style.removeProperty("--x");
                neighbor.classList.remove("active");
                pxPerFrame.reset();
                pxPerFrame.hide();
                // console.clear();
            }
        },
    );

    moveBoxRafHandler.registerStart();
    codeBlockTransition();
    withPrevious();
    registerTransition({
        begin() {},
        revert() {
            x.set(0);
        },
    });
    withPrevious();

    codeBlockTransition();
    registerTransition({
        begin() {
            stopEggAtHouse = true;
        },
        revert() {
            stopEggAtHouse = false;
        },
    });
    withPrevious();
    registerClassTransition("#neighbor", "active", "add");
    withPrevious();
    registerTransition({
        begin() {
            pxPerFrame.show();
        },
        revert() {
            pxPerFrame.hide();
            pxPerFrame.reset();
        },
    });
    withPrevious();

    codeBlockTransition();
    registerTransition({
        begin() {
            stopLoopingAtHouse = true;
        },
        revert() {
            stopLoopingAtHouse = false;
            x.set(0);
            egg.style.removeProperty("--x");
            moveBoxRafHandler.start();
        },
    });
    withPrevious();

    moveBoxRafHandler.registerEnd();
    codeBlockTransition();
    withPrevious();
    registerTransition({
        begin() {
            pxPerFrame.hide();
            pxPerFrame.reset();
        },
        revert: pxPerFrame.show,
    });
    withPrevious();
    registerClassTransition("#new-house", "yard-egg");
    withPrevious();
    registerClassTransition("#egg", "unpacked");
    withPrevious();
    registerClassTransition("#old-house", "fraud");
    withPrevious();
    registerClassTransition(".money");
    withPrevious();
</script>
