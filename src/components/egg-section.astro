<style>
    #egg-section {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: clip;
        background-color: white;
        &:not(.active) {
            opacity: 0;
            pointer-events: none;
            user-select: none;
        }
    }

    .house {
        position: fixed;
        z-index: -1;
        user-select: none;
        pointer-events: none;
        &:not(.active) {
            opacity: 0;
        }
    }

    #old-house {
        left: -5vw;
        bottom: 5vh;
        width: 50vh;

        img {
            filter: hue-rotate(-60deg) saturate(50%);
            width: 100%;
        }

        &::after {
            background-image: url("/images/house-fire.webp");
            background-size: contain;
            content: "";
            position: absolute;
            inset: 0;
            opacity: 0;
        }

        &.hot::after {
            opacity: 1;
            transition: opacity 10s;
        }
    }

    #new-house {
        right: 10vw;
        bottom: 5vh;
        width: 50vh;

        img {
            width: 100%;
        }

        &.yard-egg::after {
            content: "";
            position: absolute;
            background-image: url("/images/egg.webp");
            background-size: contain;
            width: 30%;
            aspect-ratio: 1;
            left: 35%;
            top: 57%;
            animation-name: grow-egg;
            animation-delay: 14s;
            animation-timing-function: steps(50);
            animation-duration: 100s;
            animation-fill-mode: both;
            transform-origin: bottom;
        }
    }

    @keyframes grow-egg {
        from { transform: scale(1); }
        to { transform: scale(3); }
    }

    #neighbor {
        right: -10vw;
        bottom: 11vh;
        width: 40vh;
        &.active {
            /* opacity: 0.5; */
        }
    }

    #egg {
        position: fixed;
        bottom: 17.5vh;
        width: 24vh;

        aspect-ratio: 1;
        background-color: #deafaf;
        background-size: cover;

        --initial-x: 9vw;
        --x: 0px;
        transform: translateX(calc(var(--initial-x) + var(--x)));

        &.unpacked {
            display: none;
        }
        &.fancy {
            background-color: bisque;
            border: 8px ridge burlywood;
        }
        &.faberge {
            background-image: url("/images/egg.webp");
        }
        &.right {
            background-image: url("/images/egg-right.webp");
            /* this isn't quite right, need to fix this with screen size */
            --x: 46.8vw;
        }
        &.cracked {
            background-image: url("/images/egg-cracked.webp");
        }
        &.hot {
            animation: crack-after-time 5s step-end both;
            background-color: rgb(251, 153, 146);
            transition:
                background-color 10s,
                border-color 10s;
            border-color: rgb(236, 138, 96);
        }
    }

    body:has(#egg.right) #code-wrapper {
        animation: shake 0.5s ease-out;
    }

    @keyframes shake {
        0% {
            transform: rotate(0deg);
        }
        20% {
            transform: rotate(-10deg);
        }
        40% {
            transform: rotate(8deg);
        }
        60% {
            transform: rotate(-4deg);
        }
        80% {
            transform: rotate(2deg);
        }
        100% {
            transform: rotate(0deg);
        }
    }

    @keyframes crack-after-time {
        0% {
            background-image: url("/images/egg.webp");
        }
        61% {
            background-image: url("/images/egg-cracked.webp");
        }
        100% {
            background-image: url("/images/egg-crumbled.webp");
        }
    }

    #code-wrapper {
        position: fixed;
        left: 20%;
        top: 10%;

        :global(.expressive-code):not(.active) {
            display: none;
        }

        :global(.expressive-code):not(.full-width) .code {
            max-width: 60ch;
        }
    }

    /* #rewind {
        position: fixed;
        inset: 0;
        background-image: url("/images/rewind.gif");
        background-size: cover;
        mix-blend-mode: difference;
        &:not(.active) {
            opacity: 0;
        }
    } */

    #arson-timeline {
        position: absolute;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;

        img {
            border: 4px solid black;
        }

        &:not(.active) {
            opacity: 0;
            pointer-events: none;
            user-select: none;
        }
    }

    #raf {
        position: fixed;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 4vw;
        background-color: white;
        &:not(.active) {
            display: none;
        }
    }

    .money {
        --base-delay: 10s;
        --stagger-delay: calc(var(--i, 0) * 2s);

        --amplitude: 2vh;
        --bottom: 20vh;

        position: fixed;
        width: 60px;
        aspect-ratio: 1;
        background-image: url("/images/money.png");
        background-size: contain;
        display: none;
        &.active {
            animation: money 8s linear both infinite;
            animation-delay: calc(var(--base-delay) + var(--stagger-delay));
            display: block;
        }
    }

    @keyframes money {
        0% {
            left: 5vw;
            bottom: var(--bottom);
            opacity: 0;
        }
        10%, 30%, 50%, 70%, 90% {
            bottom: calc(var(--bottom) + var(--amplitude));
        }
        25%, 85% {
            opacity: 0.8;
        }
        20%, 40%, 60%, 80% {
            bottom: var(--bottom);
        }
        100% {
            bottom: var(--bottom);
            left: 80vw;
            opacity: 0;
        }
    }
</style>
<script>
    import {
        registerClassTransition,
        registerRafTransition,
        registerTransition,
        withPrevious,
    } from "../lib/slides";

    const egg = document.getElementById("egg")!;
    const oldHouse = document.getElementById("old-house")!;
    const newHouse = document.getElementById("new-house")!;
    const neighbor = document.getElementById("neighbor")!;

    function translateEgg(x: string | "unset") {
        registerTransition(() => {
            let prev: string | undefined;
            return {
                begin() {
                    prev = egg.style.getPropertyValue("--x");
                    if (x === "unset") {
                        egg.style.removeProperty("--x");
                    } else {
                        egg.style.setProperty("--x", x);
                    }
                },
                revert() {
                    if (prev) {
                        egg.style.setProperty("--x", prev);
                    } else {
                        egg.style.removeProperty("--x");
                    }
                },
            };
        });
    }

    // code block controls
    const { codeBlockTransition, nextCodeBlock, prevCodeBlock } = (() => {
        let currentCodeBlock: Element | null = null;
        function activateCurrentCodeBlock() {
            document
                .querySelectorAll("#code-wrapper > .active")
                .forEach((el) => el.classList.remove("active"));

            currentCodeBlock?.classList.add("active");
        }

        function nextCodeBlock() {
            if (currentCodeBlock) {
                currentCodeBlock = currentCodeBlock.nextElementSibling;
            } else {
                currentCodeBlock = document.querySelector(
                    "#code-wrapper .expressive-code:first-child",
                );
            }
            activateCurrentCodeBlock();
        }

        function prevCodeBlock() {
            if (currentCodeBlock) {
                currentCodeBlock = currentCodeBlock.previousElementSibling;
            } else {
                currentCodeBlock = document.querySelector(
                    "#code-wrapper .expressive-code:last-child",
                );
            }
            activateCurrentCodeBlock();
        }

        return {
            nextCodeBlock,
            prevCodeBlock,
            codeBlockTransition: () =>
                registerTransition({
                    begin: nextCodeBlock,
                    revert: prevCodeBlock,
                }),
        };
    })();

    const { beginSetInterval, endSetInterval } = (() => {
        let intervalId: NodeJS.Timeout | undefined = undefined;
        let x = 0;
        function setX() {
            egg.style.setProperty("--x", x + "px");
        }
        function resetX() {
            egg.style.removeProperty("--x");
            x = 0;
        }
        function startInterval() {
            cancelInterval();
            intervalId = setInterval(() => {
                x++;
                setX();
            }, 1);
        }
        function cancelInterval() {
            if (intervalId) {
                clearInterval(intervalId);
                intervalId = undefined;
            }
        }

        // start setInterval
        return {
            beginSetInterval: () =>
                registerTransition({
                    begin() {
                        startInterval();
                    },
                    revert() {
                        cancelInterval();
                        resetX();
                    },
                }),
            endSetInterval: () =>
                registerTransition({
                    begin() {
                        cancelInterval();
                        resetX();
                    },
                    revert() {
                        startInterval();
                    },
                }),
        };
    })();

    // initial appear
    registerClassTransition("#egg-section");

    // egg appears
    registerClassTransition("#egg", "fancy");

    // houses
    registerClassTransition("#new-house");
    registerClassTransition("#old-house");

    registerClassTransition("#egg", "faberge");

    // code to translate all at once
    codeBlockTransition();
    codeBlockTransition();

    // go right all at once, break egg!
    registerClassTransition("#egg", "right");

    // ok, go back
    registerClassTransition("#egg", "right", "remove");
    codeBlockTransition();
    withPrevious();

    // show new code, to translate 1px at a time
    codeBlockTransition();

    codeBlockTransition();
    translateEgg("1px");
    withPrevious();

    codeBlockTransition();
    translateEgg("2px");
    withPrevious();

    codeBlockTransition();
    translateEgg("3px");
    withPrevious();

    codeBlockTransition();
    translateEgg("4px");
    withPrevious();

    codeBlockTransition();
    translateEgg("200px");
    withPrevious();

    // ok, back to drawing board
    codeBlockTransition();
    translateEgg("unset");
    withPrevious();

    // what about a while loop? start a little fire
    codeBlockTransition();
    registerClassTransition("#old-house", "hot");
    withPrevious();
    registerClassTransition("#egg", "hot");
    withPrevious();

    // show arson timeline
    registerClassTransition("#arson-timeline", "active");

    // ok enough of that
    registerClassTransition("#arson-timeline", "active", "remove");
    registerClassTransition("#old-house", "hot", "remove");
    withPrevious();
    registerClassTransition("#egg", "hot", "remove");
    withPrevious();
    codeBlockTransition();
    withPrevious();

    // try set interval
    codeBlockTransition();
    beginSetInterval();
    withPrevious();

    // cancel interval, no good
    codeBlockTransition();
    endSetInterval();
    withPrevious();

    // now introduce requestAnimationFrame
    registerClassTransition("#raf", "active");

    registerClassTransition("#raf", "active", "remove");
    codeBlockTransition();
    withPrevious();

    registerRafTransition((timestamp) => {
        console.log(timestamp);
        return false;
    }, {});
    codeBlockTransition();
    withPrevious();

    let cancelRafTransition = registerRafTransition((timestamp) => {
        console.log(timestamp);
        return true;
    }, {});
    codeBlockTransition();
    withPrevious();

    cancelRafTransition();
    codeBlockTransition();
    withPrevious();

    codeBlockTransition();
    cancelRafTransition = registerRafTransition(
        (_, state) => {
            state.x++;
            console.log(state.x);
            egg.style.setProperty("--x", state.x + "px");
            return true;
        },
        { x: 0 },
        () => {
            egg.style.removeProperty("--x");
        },
    );
    withPrevious();

    cancelRafTransition();
    codeBlockTransition();
    withPrevious();

    cancelRafTransition = registerRafTransition(
        (_, state) => {
            state.x += 5;
            egg.style.setProperty("--x", state.x + "px");

            if (
                state.x >
                    newHouse.offsetLeft -
                        oldHouse.offsetLeft -
                        newHouse.clientWidth &&
                !neighbor.classList.contains("active")
            ) {
                neighbor.classList.add("active");
            }

            return state.x < window.innerWidth;
        },
        { x: 0 },
        (event) => {
            if (event === "revert") {
                neighbor.classList.remove("active");
            } else {
                neighbor.classList.add("active");
            }
            egg.style.removeProperty("--x");
        },
    );
    codeBlockTransition();
    withPrevious();

    cancelRafTransition();
    codeBlockTransition();
    withPrevious();

    cancelRafTransition = registerRafTransition(
        (_, state) => {
            state.x += 5;
            egg.style.setProperty("--x", state.x + "px");
            return (
                state.x <
                newHouse.offsetLeft -
                    oldHouse.offsetLeft -
                    newHouse.clientWidth / 2
            );
        },
        { x: 0 },
        (event) => {
            if (event === "revert") {
                egg.style.removeProperty("--x");
            } else {
                egg.style.setProperty(
                    "--x",
                    newHouse.offsetLeft -
                        oldHouse.offsetLeft -
                        newHouse.clientWidth / 2 +
                        "px",
                );
            }
        },
    );
    codeBlockTransition();
    withPrevious();

    cancelRafTransition();
    codeBlockTransition();
    withPrevious();
    registerClassTransition("#new-house", "yard-egg");
    withPrevious();
    registerClassTransition("#egg", "unpacked");
    withPrevious();
    registerClassTransition("#old-house", "hot");
    withPrevious();
    registerClassTransition(".money");
    withPrevious();

    // oh no, it's going too far, that's your neighbor!
    // registerClassTransition("#neighbor");
</script>
