---
import type { HTMLAttributes } from "astro/types";

export type Props = {
    name: string;
    label?: string;
} & (
    | {
          type: "values";
          values: number[];
          index?: number;
      }
    | {
          type: "range";
          min: number;
          max: number;
          step?: number;
          value?: number;
      }
    | {
          type: "checkbox";
          value?: boolean;
      }
);

const props = Astro.props;
let initialValue: string;
const inputProps: HTMLAttributes<"input"> = {
    name: props.name,
    id: "control-" + props.name,
};

switch (props.type) {
    case "checkbox":
        inputProps.type = "checkbox";
        inputProps.checked = props.value ?? false;
        initialValue = String(inputProps.checked);
        break;
    case "range":
        inputProps.type = "range";
        inputProps.max = props.max;
        inputProps.min = props.min;
        inputProps.step = props.step ?? 1;
        inputProps.value =
            props.value ?? (props.max - props.min) / 2 + props.min;
        initialValue = String(inputProps.value);
        break;
    case "values":
        inputProps.type = "range";
        inputProps.min = 0;
        inputProps.max = props.values.length - 1;
        inputProps.step = 1;
        inputProps.value =
            props.index ?? Math.floor(props.values.length / 2);
        inputProps["data-values"] = JSON.stringify(props.values);
        initialValue = String(props.values[inputProps.value]);
        break;
}
---

<div data-control>
    <label data-control-label for={inputProps.id}
        >{props.label ?? props.name}</label
    >
    <input data-control-input {...inputProps} />
    {
        props.type !== "checkbox" && (
            <span data-control-display>{initialValue}</span>
        )
    }
</div>

<style>
    [data-control] {
        display: flex;
        align-items: center;
        font-family: monospace;
        gap: 1ch;
    }
</style>

<script>
    import { addControlListener, setControlValue } from "../lib/controlStore";

    function setUpCheckbox(input: HTMLInputElement) {
        input.addEventListener("input", () => {
            setControlValue(input.name, input.checked);
        });
        setControlValue(input.name, input.checked);
        addControlListener<boolean>(input.name, (value) => {
            input.checked = value;
        });
    }

    function setUpRange(input: HTMLInputElement) {
        if (input.dataset.values) {
            const values = JSON.parse(input.dataset.values) as number[];
            input.addEventListener("input", () => {
                setControlValue(input.name, values[parseInt(input.value)]);
            });
            setControlValue(input.name, values[parseInt(input.value)]);
            addControlListener<number>(input.name, (value) => {
                let shortest: [number, number] = [-1, Infinity];
                for (let i = 0; i < values.length; i++) {
                    const d = Math.abs(values[i] - value);
                    if (d < shortest[1]) {
                        shortest[0] = i;
                        shortest[1] = d;
                    }
                }
                input.value = shortest[0].toString();
                if (input.nextElementSibling) {
                    input.nextElementSibling.innerHTML =
                        values[shortest[0]].toString();
                }
            });
        } else {
            input.addEventListener("input", () => {
                setControlValue(input.name, parseInt(input.value));
            });
            setControlValue(input.name, parseInt(input.value));
            addControlListener<number>(input.name, (value) => {
                input.value = String(value);
                if (input.nextElementSibling) {
                    input.nextElementSibling.innerHTML = input.value;
                }
            });
        }
    }

    document
        .querySelectorAll<HTMLInputElement>("[data-control-input]")
        .forEach((input) => {
            switch (input.type) {
                case "checkbox":
                    setUpCheckbox(input);
                    break;
                case "range":
                    setUpRange(input);
                    break;
            }
        });
</script>
