---
interface Props {
    x: number | string;
    y: number | string;
    src?: string;
    id?: string;
    class?: string;
    figure?: number | string;
    width?: number | string;
    border?: boolean;
    pixelate?: boolean;
}

const props = Astro.props;

const x = typeof props.x === "number" ? props.x : parseFloat(props.x);
const y = typeof props.y === "number" ? props.y : parseFloat(props.y);

const width = props.width
    ? typeof props.width === "number"
        ? `${props.width}px`
        : props.width
    : "auto";

if (!props.src && !Astro.slots.has("figure")) {
    throw `figure must have a src attribute or <slot name="figure">`;
}

let classString = props.class ?? "";
if (props.border || Astro.slots.has("default")) {
    classString += " bordered";
}
if (props.src && props.pixelate) {
    classString += " pixelate";
}

let captionHtml = "";
if (Astro.slots.has("default")) {
    if (props.figure) {
        captionHtml += "<b>Figure " + props.figure + ":</b> &nbsp; &nbsp; ";
    }

    captionHtml += await Astro.slots.render("default");

    let closeBacktick = true;
    for (let i = captionHtml.length - 1; i > -1; i--) {
        let replacement: string | undefined = undefined;
        switch (captionHtml[i]) {
            case "[":
                replacement = "<sup>[";
                break;
            case "]":
                replacement = "]</sup>";
                break;
            case "`":
                replacement = closeBacktick ? "</code>" : "<code>";
                closeBacktick = !closeBacktick;
                break;
        }

        if (replacement) {
            captionHtml =
                captionHtml.substring(0, i) +
                replacement +
                captionHtml.substring(i + 1);
        }
    }
}
---

<figure
    id={props.id}
    data-grabbable-figure
    class={classString.trim()}
    style={`--start-x: ${x}; --start-y: ${y}; --width: ${width};`}
>
    {
        props.src ? (
            <img
                src={props.src}
                alt="a very academic figure"
                draggable="false"
            />
        ) : (
            <slot name="figure" />
        )
    }
    {captionHtml && <figcaption set:html={captionHtml} />}
</figure>
<style>
    figure {
        position: fixed;

        --start-x: 0.5;
        --start-y: 0.5;
        --width: auto;
        width: var(--width);

        left: calc(100vw * var(--start-x));
        top: calc(100vh * var(--start-y));

        margin: 0;
        cursor: grab;
        user-select: none;
        touch-action: manipulation;

        --drag-x: 0px;
        --drag-y: 0px;
        --s: 1;
        transform: translate(
                calc(var(--drag-x) - 50%),
                calc(var(--drag-y) - 50%)
            )
            scale(var(--s));
    }

    figure.bordered {
        padding: 2vh;
        background-color: #fafaff;
        border: 1px solid black;
        outline: 4px solid #fafaff;
    }

    figure:not(.active) {
        display: none;
    }

    figure img {
        width: 100%;
    }

    figure.pixelate img {
        image-rendering: pixelated;
    }

    figcaption {
        margin-top: 0.5lh;
        font-family: 'Times New Roman', Times, serif;
        text-indent: -1ch;
        /* margin-inline: 1ch; */
        padding-inline: 1ch;
        line-height: 1.4;

        :global(sup) {
            line-height: 0;
        }

        :global(code) {
            font-family: "Recursive";
            font-variation-settings:
                "MONO" 1,
                "CASL" 1,
                "slnt" -5,
                "CRSV" 0;
            font-size: 0.85em;
            color: darkslategrey;
            background-color: lavender;
            border-radius: 0.25em;
            padding: 0.1em 0.5ch;
        }

        :global(a) {
            color: darkslateblue;
            &:hover {
                text-decoration: none;
            }
        }
    }
</style>
<script>
    import { initFigures } from "../lib/figures";
    document.addEventListener("DOMContentLoaded", initFigures);
</script>
