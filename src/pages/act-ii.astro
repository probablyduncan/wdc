---
import Slide from "../components/slide.astro";
---

<Slide next="spider">
    <h1 id="act">ACT II</h1>
    <h2 id="springtime">SPRINGTIME</h2>
</Slide>
<style>
    h1,
    h2 {
        margin: 0;
        line-height: 1;
    }
    h1 {
        text-align: center;
        font-family:
            Impact, "Haettenschweiler", "Arial Narrow Bold", sans-serif;
        font-size: 40vw;

        &.active {
            font-size: 20vw;
        }
        --x: 0;
        --y: 50px;
        transform: translate(var(--x), var(--y));
    }
    h2 {
        text-align: right;
        font-size: 15vw;
        font-family: "Recursive";
        font-variation-settings:
            "MONO" 1,
            "CASL" 0,
            "slnt" -15,
            "CRSV" 0;
        --x: -100vw;
        --s: 1;
        transform: translateX(var(--x)) scale(var(--s));
    }
</style>
<script>
    import AnimationFrameController from "../lib/animationFrameController";
    import { SpringController } from "../lib/interpolationController";
    import { registerTransition } from "../lib/slides";

    registerTransition(() => {
        const el = document.getElementById("springtime")!;
        const h1 = document.getElementById("act")!;
        const x = new SpringController({
            stiffness: 200,
            damping: 5,
            mass: 2,
        });

        const h1x = new SpringController({
            stiffness: 200,
            damping: 5,
            mass: 2,
        });
        const h1y = new SpringController({
            stiffness: 200,
            damping: 5,
            mass: 2,
        });

        function updatePosition() {
            el.style.setProperty("--x", x.current + "px");
            el.style.setProperty("--s", (1).toString());
            h1.style.setProperty("--x", h1x.current + "px");
            h1.style.setProperty("--y", h1y.current + "px");
        }

        const initialX = (x.current = -window.innerWidth);
        // h1y.target = -100;

        const a = new AnimationFrameController((deltaMS) => {
            x.step(deltaMS);
            h1x.step(deltaMS);
            h1y.step(deltaMS);
            updatePosition();
            return !x.isAtRest();
        });

        return {
            begin() {
                x.target = 0;
                x.current = initialX;
                h1y.current = 50;
                h1x.velocity = 1000;
                a.playIfPaused();
            },
            revert() {
                if (a.isRunning) {
                    a.pause();
                }
                x.current = initialX;
                updatePosition();
            },
        };
    });
</script>
