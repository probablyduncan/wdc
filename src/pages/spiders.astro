import Figure from "../components/figure.astro";
import Slide from "../components/slide.astro";
---

<Slide prev="examples">
    <section id="cern">
        <h1>
            World Wide Web <span id="web-emoji" style="line-height: 0;" hidden
                >🕸️</span>
        </h1>
        The WorldWideWeb (W3) is a wide-area <a>hypermedia</a> information retrieval
        initiative aiming to give universal access to a large universe of documents.
        <p>
            Everything there is online about W3 is linked directly or indirectly
            to this document, including an <a>executive summary</a> of the project,
            <a>Mailing lists</a>, <a>Policy</a>, November's <a class="visited"
                >W3 news</a
            >, <a>Frequently Asked Questions</a>.
        </p>
        <dl>
            <dt>
                <a class="visited">What's out there?</a>
            </dt><dd>
                Pointers to the world's online information, <a>subjects</a>, <a
                    >W3 servers</a
                >, etc.
            </dd><dt>
                <a>Help</a>
            </dt><dd>on the browser you are using</dd><dt>
                <a>Software Products</a>
            </dt><dd>
                A list of W3 project components and their current state. (e.g. <a
                    class="visited">Line Mode</a
                >, X11 <a>Viola</a>, <a>NeXTStep</a>, <a>Servers</a>, <a
                    >Tools</a
                >, <a class="visited">Mail robot</a>, <a>Library</a>)
            </dd><dt>
                <a>Technical</a>
            </dt><dd>
                Details of protocols, formats, program internals etc
            </dd><dt>
                <a>Bibliography</a>
            </dt><dd>Paper documentation on W3 and references.</dd><dt>
                <a class="visited">People</a>
            </dt><dd>A list of some people involved in the project.</dd><dt>
                <a>History</a>
            </dt><dd>A summary of the history of the project.</dd><dt>
                <a>How can I help</a> ?
            </dt><dd>If you would like to support the web..</dd><dt>
                <a>Getting code</a>
            </dt><dd>
                Getting the code by <a>anonymous FTP</a>, etc.
            </dd>
        </dl>
    </section>
    <canvas id="itsy-bitsy"></canvas>
    <section id="code">
        <Code lang="html" code={`<canvas id="itsy-bitsy-canvas"></canvas>`} />
        <Code
            lang="typescript"
            code={`
const canvas = document.getElementById("itsy-bitsy-canvas");
const context = canvas.getContext("2d");
`}
        />
        <Code
            lang="typescript"
            code={`
const canvas = document.getElementById("itsy-bitsy-canvas");
const context = canvas.getContext("2d");

context.beginPath();
context.arc(
    canvas.width * 0.618,
    canvas.height * 0.5,
    500,
    0,
    2 * Math.PI);

context.fillStyle = "black";
context.fill();
`}
        />
        <Code
            lang="typescript"
            collapse={"1-13"}
            code={`
const canvas = document.getElementById("itsy-bitsy-canvas");
const context = canvas.getContext("2d");

context.beginPath();
context.arc(
    spiderPosition.x,
    spiderPosition.y,
    500,
    0,
    2 * Math.PI);

context.fillStyle = "black";
context.fill();

context.beginPath();
context.ellipse(
    spiderPosition.x + Math.cos(spiderAngle) * 100,
    spiderPosition.y + Math.sin(spiderAngle) * 100,
    100,
    70,
    spiderAngle
    0,
    2 * Math.PI);
context.fillStyle = "black";
context.fill();
`}
        />
        <Code
            lang="typescript"
            code={`
const canvas = document.getElementById("itsy-bitsy-canvas");
const context = canvas.getContext("2d");

function drawFrame(timestamp: DOMHighResTimeStamp) {

    // update positions
    spider.current.x += // etc etc

    // clear canvas for next paint
    context.clearRect(0, 0, canvasSize.x, canvasSize.y);
    
    // draw shapes
    context.beginPath();
    // ...
    context.fill();

    // request next frame
    requestAnimationFrame(drawFrame)
}

requestAnimationFrame(drawFrame);
`}
        />
    </section>
    <Figure id="owl" src="/images/owl.jpg" x={0.25} y={0.4} width="70vmin">
