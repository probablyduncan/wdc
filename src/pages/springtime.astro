---
import { Code } from "astro-expressive-code/components";
import Slide from "../components/slide.astro";
import Figure from "../components/figure.astro";

// this is all it is!

// F(s) = K*x
// F(d) = D*v

// F = M*a
// m*a = F(s) - f(d)
// a = (F(s) - F(d)) / m

// v = x/s, a = v/s
// x = v * s, v = a * s

// so, v = s * (F(s) - F(d)) / m
// and x = s * v

const mass = 2;
const damping = 20;
const stiffness = 100;

let current = 0;
let target = 0;
let velocity = 0;

function step(seconds: number) {
    const springForce = stiffness * (target - current);
    const dampingForce = damping * velocity;
    const acceleration = (springForce - dampingForce) / mass;
    velocity += acceleration * seconds;
    current += velocity * seconds;
}

// const editFile = `vscode://file${Astro.self.moduleId}`;
function getEditFileLink() {
    return import.meta.env.MODE.startsWith("dev")
        ? `vscode://file${Astro.self.moduleId}`
        : `https://github.com/probablyduncan/wdc/tree/main/${Astro.self.moduleId}`;
}

console.log(import.meta.dirname); // in build this will be in /dist
console.log(import.meta.filename); // in build this will be in /dist
console.log(import.meta.hot); // this is set when hot reload is on, otherwise not
console.log(import.meta.url); // this is the file url!

// basically, if we're hot we want to
---

