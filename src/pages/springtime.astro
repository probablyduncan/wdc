        <math slot="figure">
            <mi>a</mi>
            <mo>=</mo>
            <mi>k</mi>
            <mi>x</mi>
            <mo>/</mo>
            <mi>m</mi>
        </math>
        The acceleration of the thing at the end of the spring
    </Figure>
    <Figure id="math-fd" x="0.5" y="0.5" class="active" border={true}>
        <math slot="figure">
