    import { registerTransition, withPrevious } from "../lib/slides";

    const codeClasses = getCodeBlockTransitions("code-classes");
    const codeUses = getCodeBlockTransitions("code-uses");

    // create a lerp class
    codeClasses.next();
    codeClasses.next();
    codeClasses.next();

    // how do we use this?
    codeUses.next();
    codeUses.next();
    codeUses.next();
    codeUses.next();
    codeUses.hide();

    // ok now spring class
    codeClasses.next();
    withPrevious();

    codeClasses.next();
    codeClasses.next();
    codeClasses.next();
    codeClasses.next();
</script>
