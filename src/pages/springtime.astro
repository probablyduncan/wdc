<style>
    :global(body.road) {
        background-image: url("/images/chicken-bg.webp");
        image-rendering: pixelated;
        background-size: 100%;
        background-position: bottom center;
        background-repeat: no-repeat;
        background-color: white;
    }

    #code-classes {
        position: fixed;
        top: 2ch;
        left: 2ch;
        z-index: 90;
    }

    :global(.expressive-code) {
        &:not(.active) {
            display: none;
        }
    }

    #code-uses :global(code) {
        width: 60ch;
    }

    math {
        font-size: 2em;
    }

    math ~ :global(*) em {
        font-weight: bold;
        font-style: italic;
        margin-inline-end: 0.5ch;
    }

    .math-steps > math:not(.active) {
        width: 0;
        visibility: hidden;
    }

    #chicken {
        image-rendering: pixelated;
        aspect-ratio: 1;
        --width: 25vw;
        width: var(--width);
        position: fixed;
        bottom: 0;
        left: 0;
        user-select: none;
        pointer-events: none;
        --d: 1;
        translate: calc(var(--x, 50vw) - 50%) calc(var(--y, -50vh) + 50%);
        scale: calc(var(--d) * var(--s, 1)) var(--s, 1);
        z-index: 85;
    }

    #spring-sliders {
        position: fixed;
        top: 2ch;
        left: 50%;
        translate: -50%;
        padding: 1ch;
        border-radius: 1ch;
        font-size: 0.75em;

        div {
            display: grid;
            align-items: center;
            width: clamp(20vw, 350px, 95vw);
            margin-bottom: 2ch;

            transform: translateX(var(--x, 0));
            transition: opacity 0.5s;

            &:not(.active) {
                opacity: 0;
            }

            input {
                grid-column: 1 / 3;
            }

            label {
                justify-self: start;
            }

            output {
                justify-self: end;
            }
        }

        label,
        output,
        button {
            padding: 0.25em 0.5em;
            margin-inline: 0.25em;
            background-color: white;
            border-radius: 0.25em;
            box-shadow: 0 0 0.125em #00000044;
        }

        button {
            width: 100%;
            /* padding-block: 0,5; */
            /* border: 0.125em outset #00000055; */
            cursor: pointer;
            &:not(.active) {
                display: none;
            }

            transition:
                font-variation-settings 0.2s,
                font-weight 0.2s;
            font-variation-settings:
                "MONO" 1,
                "CASL" 0,
                "slnt" 0,
                "CRSV" 1;
        }

        button:hover {
            font-weight: 500;
            font-variation-settings:
                "MONO" 1,
                "CASL" 1,
                "slnt" -15,
                "CRSV" 1;
        }

        button:active {
            font-weight: 700;
        }
    }
</style>
<script>
    import AnimationFrameController from "../lib/animationFrameController";
    import { addConstControl } from "../lib/codeBlockHelpers";
    import { getChildTransitions } from "../lib/codeBlockHelpers";
    import {
        LerpController,
        SpringController,
        type InterpolationController,
        type SpringOptions,
    } from "../lib/interpolationController";
    import {
        registerClassTransition,
        registerTransition,
        withPrevious,
    } from "../lib/slides";

    const codeClasses = getChildTransitions("code-classes", ".expressive-code");
    const codeUses = getChildTransitions("code-uses", ".expressive-code");

    const chicken = document.getElementById("chicken") as HTMLImageElement;

    class EmptyInterpolationController implements InterpolationController {
        current = 0;
        target = 0;
        step() {
            return this.current;
        }
        isAtRest() {
            return true;
        }
        reset(current: number = 0) {
            this.current = this.target = current;
        }
        fastForward() {}
    }

    const xControllers = {
        empty: new EmptyInterpolationController(),
        spring: new SpringController(),
        lerp: new LerpController(),
    };

    let currentType: keyof typeof xControllers = "empty";
    const startX = window.innerWidth / 3;
    const startY = window.innerHeight * -0.02 + chicken.clientWidth / -2;
    // @ts-ignore
    const startD = chicken.computedStyleMap().get("--d")[0];

    function xController() {
        return xControllers[currentType];
    }

    let translateY = false;
    const yController = new SpringController();
    yController.current = yController.target = startY;

    let scaleY = false;
    function getScale() {

        const horizon = -window.innerWidth / 16 * 5.5;
        if (yController.current < horizon) {
            return 0;
        }

        if (yController.current > startY) {
            return 1;
        }

        // max is startY, min is topToHorizon
        const lerp =
            (yController.current - horizon) / (startY - horizon);
        const scaleAtHorizon = 0.05;
        const scale = lerp * (1 - scaleAtHorizon) + scaleAtHorizon;
        return scale;
    }

    function useController(
        type: keyof typeof xControllers,
        shouldReset: boolean,
    ) {
        if (shouldReset) {
            resetChicken();
        } else {
            xControllers[type].current =
                xControllers[type].target =
                xControllers[currentType].current =
                    xControllers[currentType].target;
        }
        currentType = type;
    }

    function resetChicken() {
        Object.values(xControllers).forEach((i) => {
            i.reset(startX);
        });
        chicken.style.setProperty("--x", startX.toFixed(2) + "px");
        chicken.style.setProperty("--d", startD.toString());
        chicken.style.setProperty("--y", startY.toString());
    }

    function useInterpolator(
        type: keyof typeof xControllers,
        shouldReset: "both" | "none" | "revert" | "begin",
    ) {
        let prev: keyof typeof xControllers;
        registerTransition({
            begin() {
                prev = currentType;
                useController(
                    type,
                    shouldReset === "both" || shouldReset === "begin",
                );
            },
            revert() {
                useController(
                    prev,
                    shouldReset === "both" || shouldReset === "revert",
                );
            },
        });
    }

    {
        let mouseDown = false;
        window.addEventListener("mousedown", ({ target, clientX, clientY }) => {
            if ((target as HTMLElement).tagName === "MAIN") {
                mouseDown = true;
                xController().target = clientX;
                if (translateY) {
                    yController.target = clientY - window.innerHeight;
                }
            }
        });
        window.addEventListener("mouseup", () => {
            mouseDown = false;
        });
        window.addEventListener("mousemove", ({ clientX, clientY }) => {
            if (mouseDown) {
                xController().target = clientX;
                if (translateY) {
                    yController.target = clientY - window.innerHeight;
                }
            }
        });
    }

    function setupSpringSlider(inputSelector: string, values: number[]) {
        const input = document.querySelector<HTMLInputElement>(inputSelector)!;
        const codeBlockControl = addConstControl(input.name + " =", values, {
            additionalInputSelector: inputSelector,
            startInlineInputsHidden: true,
        });

        const translatableParent = input.parentElement!;
        const outputs = document.querySelectorAll<HTMLOutputElement>(
            `output[for="${input.name}"]`,
        );

        function strAndNum(str: string) {
            return { str, num: parseInt(str) };
        }

        // store these for after animation is complete
        let value = strAndNum(input.value);
        const min = strAndNum(input.min);
        const max = strAndNum(input.max);

        const rangeX = new SpringController();
        const thumbX = new SpringController({
            damping: 24,
            mass: 3,
            stiffness: 120,
        });

        function getInputValueDuringAnimation() {
            // diff between input and value currents gets distance from center
            // we need to add the offset from the initial value, i.e. where value should end up
            return (
                ((value.num - min.num) / (max.num - min.num)) *
                    input.clientWidth -
                input.clientWidth / 2 +
                thumbX.current -
                rangeX.current
            ).toFixed();
        }

        function getCodeMargin() {
            const top = document
                .getElementById("code-classes")!
                .computedStyleMap()
                .get("top");
            // @ts-ignore
            return top.value;
        }

        type SliderPosition =
            "middle" | "left" | "right" | "offLeft" | "offRight";
        function getSliderPosition(position: SliderPosition) {
            switch (position) {
                case "middle":
                    return 0;
                case "offLeft":
                    return (
                        (window.innerWidth + translatableParent.clientWidth) /
                        -2
                    );
                case "offRight":
                    return (
                        (window.innerWidth + translatableParent.clientWidth) / 2
                    );
                case "left":
                    return (
                        translatableParent.clientWidth / 2 -
                        window.innerWidth / 2 +
                        getCodeMargin()
                    );
                case "right":
                    return (
                        window.innerWidth / 2 -
                        translatableParent.clientWidth / 2 -
                        getCodeMargin()
                    );
            }
        }

        function setupForAnimation(from: SliderPosition, to: SliderPosition) {
            rangeX.current = thumbX.current = getSliderPosition(from);
            rangeX.target = thumbX.target = getSliderPosition(to);
            rangeX.velocity = thumbX.velocity = 0;

            translatableParent.style.setProperty("--x", rangeX.current + "px");

            // set range as width in pixels
            input.min = (input.clientWidth / -2).toString();
            input.max = (input.clientWidth / 2).toString();
            input.value = getInputValueDuringAnimation();
        }

        function onAnimationComplete() {
            input.min = min.str;
            input.max = max.str;
            input.value = value.str;
            codeBlockControl.set(values[value.num]);
        }

        const animation = new AnimationFrameController(({ deltaMS }) => {
            rangeX.step(deltaMS);
            thumbX.step(deltaMS);

            translatableParent.style.setProperty("--x", rangeX.current + "px");
            input.value = getInputValueDuringAnimation();

            if (thumbX.isAtRest()) {
                onAnimationComplete();
                return false;
            }
            return true;
        });

        codeBlockControl.listen((v) => {
            outputs.forEach((output) => (output.innerText = v.toString()));
            value = {
                num: values.indexOf(v),
                str: values.indexOf(v).toString(),
            };
        });

        function animate(
            from: SliderPosition,
            to: SliderPosition,
            delay: number = 10,
        ) {
            setTimeout(() => {
                setupForAnimation(from, to);
                translatableParent.classList.add("active");
                animation.playIfPaused();
            }, delay);
        }

        return {
            getValue: codeBlockControl.get,
            setValue: codeBlockControl.set,
            listenForValueChange: codeBlockControl.listen,
            registerAnimate(
                from: SliderPosition,
                to: SliderPosition,
                delay: number = 10,
            ) {
                registerTransition({
                    begin() {
                        animate(from, to, delay);
                    },
                    revert() {
                        animate(to, from, delay);
                    },
                });
            },
        };
    }

    const stiffness = setupSpringSlider(
        `input[name="stiffness"]`,
        [0, 0.5, 1, 2, 10, 50, 100, 200, 500, 1000],
    );
    stiffness.listenForValueChange(
        (value) => (xControllers.spring.options.stiffness = value),
    );

    const mass = setupSpringSlider(
        `input[name="mass"]`,
        [0, 0.25, 0.5, 1, 2, 5, 10, 15],
    );
    mass.listenForValueChange(
        (value) => (xControllers.spring.options.mass = value),
    );

    const damping = setupSpringSlider(
        `input[name="damping"]`,
        [0, 1, 2, 4, 8, 16, 20, 36, 60, 100],
    );

    damping.listenForValueChange(
        (value) => (xControllers.spring.options.damping = value),
    );

    function springSettingTransition(options: Partial<SpringOptions>) {
        const springControllerOptionsObject = xControllers["spring"].options;
        let prev: SpringOptions;
        registerTransition({
            begin() {
                prev = { ...springControllerOptionsObject };

                Object.assign(springControllerOptionsObject, options);
                Object.assign(yController.options, options);

                stiffness.setValue(springControllerOptionsObject.stiffness);
                mass.setValue(springControllerOptionsObject.mass);
                damping.setValue(springControllerOptionsObject.damping);
            },
            revert() {
                Object.assign(springControllerOptionsObject, prev);
                Object.assign(yController.options, prev);

                stiffness.setValue(springControllerOptionsObject.stiffness);
                mass.setValue(springControllerOptionsObject.mass);
                damping.setValue(springControllerOptionsObject.damping);
            },
        });
    }

    const chickenFrames = {
        current: {
            id: "idle",
            index: -1,
            timestampMS: 0,
        },
        idle: "stand",
        msPerFrame: 166.6666666667,
        move: [
            {
                id: "dash",
                min: 1,
                frames: ["dash-1", "dash-2", "dash-3", "dash-4"],
            },
            {
                id: "run",
                min: 0.5,
                frames: ["run-1", "run-2", "run-3", "run-4"],
            },
            {
                id: "walk",
                min: 0.1,
                frames: ["walk-1", "walk-2", "walk-3", "walk-4"],
            },
            {
                id: "shuffle",
                min: 0.005,
                frames: ["walk-2", "walk-4", "walk-2", "walk-4"],
            },
            {
                id: "almost-stand",
                min: 0,
                frames: ["walk-2"],
            },
        ],
        getSrc(frame: string) {
            return `/images/chicken-${frame}.webp`;
        },
    };

    {
        // preload frames
        chickenFrames.move.forEach((m) => {
            m.frames.forEach((frame) => {
                const preload = new Image();
                preload.src = chickenFrames.getSrc(frame);
            });
        });
        const preloadLook = new Image();
        preloadLook.src = chickenFrames.getSrc("look");
    }

    const animationController = new AnimationFrameController(
        ({ deltaMS, timestampMS }) => {
            const x = xController();
            const prevX = x.current;
            const newX = x.step(deltaMS);
            const deltaX = newX - prevX;
            const v = Math.abs(deltaX / deltaMS);

            let frames = [chickenFrames.idle];
            let newId = "idle";

            if (x.isAtRest()) {
                x.fastForward();
            } else {
                for (const moveConfig of chickenFrames.move) {
                    if (v > moveConfig.min) {
                        frames = moveConfig.frames;
                        newId = moveConfig.id;
                        break;
                    }
                }
            }

            if (
                newId !== chickenFrames.current.id ||
                timestampMS - chickenFrames.current.timestampMS >
                    chickenFrames.msPerFrame
            ) {
                chickenFrames.current.timestampMS = timestampMS;
                chickenFrames.current.id = newId;
                chickenFrames.current.index =
                    (chickenFrames.current.index + 1) % frames.length;
                chicken.src = chickenFrames.getSrc(
                    frames[chickenFrames.current.index],
                );
            }

            if (deltaX !== 0) {
                chicken.style.setProperty("--d", Math.sign(deltaX).toString());
            }

            chicken.style.setProperty("--x", newX.toFixed(2) + "px");
            chicken.style.setProperty(
                "--y",
                yController.step(deltaMS).toFixed(2) + "px",
            );

            if (scaleY) {
                const scale = getScale();
                chicken.style.setProperty("--s", scale.toFixed(2));
            }
            return true;
        },
    );

    function registerEggTransition() {
        let abortController: AbortController | undefined;

        function layEgg() {
            const scale = getScale();

            const img = document.createElement("img");
            img.src = "/images/egg.webp";
            img.classList.add("laid-egg");

            const sizeInRelationToChicken = 1 / 4;
            img.style.width =
                scale * chicken.clientWidth * sizeInRelationToChicken + "px";
            img.style.position = "fixed";
            img.style.left =
                (100 * xController().current) / window.innerWidth + "%";
            img.style.bottom =
                -yController.current - (chicken.clientHeight * scale) / 5 + "px";
            img.style.pointerEvents = "none";
            img.style.userSelect = "none";
            img.style.translate = `-50%`;
            img.alt = "an egg laid by a spring chicken";
            img.style.zIndex = (scale * 70).toFixed();
            chicken.parentElement!.insertBefore(img, chicken);
        }

        registerTransition({
            begin() {
                const button = document.getElementById("lay-egg");
                if (!button) {
                    return;
                }

                abortController = new AbortController();
                button.addEventListener("click", layEgg, {
                    signal: abortController.signal,
                });
                window.addEventListener(
                    "keypress",
                    (e) => {
                        if (e.key === "e") {
                            layEgg();
                        }
                    },
                    {
                        signal: abortController.signal,
                    },
                );
                button.classList.add("active");
            },
            revert() {
                if (abortController) {
                    document
                        .getElementById("lay-egg")
                        ?.classList.remove("active");
                    abortController.abort();
                    abortController = undefined;
                    document
                        .querySelectorAll(".laid-egg")
                        .forEach((e) => e.remove());
                }
            },
        });
    }

    registerClassTransition("body", "road");
    registerTransition({
        begin() {
            resetChicken();
            animationController.playIfPaused();
        },
        revert() {
            animationController.pause();
            chicken.style.removeProperty("--x");
            chicken.style.removeProperty("--y");
            chicken.style.removeProperty("--d");
        },
    });
    withPrevious();

    // create a lerp class
    codeClasses.next();
    codeClasses.next();
    codeClasses.next();

    // how do we use this?
    codeUses.next();
    codeUses.next();
    codeUses.next();

    codeUses.next();
    useInterpolator("lerp", "both");
    withPrevious();

    // ok now spring class
    codeUses.hide();
    codeClasses.next();
    withPrevious();
    useInterpolator("empty", "both");
    withPrevious();

    // ok math time

    registerClassTransition("#gcse-physics", "active", "add");
    registerTransition({
        begin() {
            chickenFrames.idle = "look";
        },
        revert() {
            chickenFrames.idle = "stand";
        },
    });
    withPrevious();
    springSettingTransition({
        damping: 0,
        stiffness: 1,
        mass: 1,
    });
    withPrevious();

    registerClassTransition("#math-fs", "active", "add");
    codeClasses.next();

    // calculate
    const fmaTransitions = getChildTransitions("math-fma", "math");
    registerClassTransition("#math-fma", "active", "add");
    codeClasses.next();
    withPrevious();

    // calculate acceleration
    fmaTransitions.next();
    codeClasses.next();
    withPrevious();

    // calculate v and a
    codeClasses.next();
    registerClassTransition("#math-vat", "active", "add");
    withPrevious();
    codeClasses.next();

    codeClasses.next();
    registerClassTransition("#math-xvt", "active", "add");
    withPrevious();

    // ok, it's wired up now
    // naive first version, no damping, not tracking velocity
    codeClasses.next();
    useInterpolator("spring", "both");
    withPrevious();
    springSettingTransition({
        damping: 0,
        stiffness: 1,
        mass: 1,
    });
    withPrevious();

    codeClasses.next();
    registerClassTransition("#math-fd", "active", "add");
    withPrevious();
    useInterpolator("empty", "both");
    withPrevious();
    springSettingTransition({
        damping: 1,
        stiffness: 1,
        mass: 1,
    });
    withPrevious();

    codeClasses.next();
    registerClassTransition("#math-fd-fs", "active", "add");
    const fdfsTransitions = getChildTransitions("math-fd-fs", "math");
    fdfsTransitions.next();
    codeClasses.next();
    withPrevious();

    // clear everything and activate spring!
    codeClasses.next();
    registerClassTransition(
        "#gcse-physics, #math-fs, #math-fma, #math-vat, #math-xvt, #math-fd, #math-fdm, #math-fd-fs",
        "active",
        "remove",
    );
    withPrevious();
    useInterpolator("spring", "both");
    withPrevious();
    registerTransition({
        begin() {
            chickenFrames.idle = "stand";
        },
        revert() {
            chickenFrames.idle = "look";
        },
    });
    withPrevious();

    codeClasses.next();
    springSettingTransition({
        damping: 20,
        stiffness: 100,
        mass: 2,
    });
    withPrevious();

    codeClasses.next();
    codeClasses.hide();

    stiffness.registerAnimate("offLeft", "middle");
    mass.registerAnimate("offLeft", "middle");
    damping.registerAnimate("offLeft", "middle");

    stiffness.registerAnimate("middle", "right", 100);
    mass.registerAnimate("middle", "right", 200);
    withPrevious();
    damping.registerAnimate("middle", "right", 300);
    withPrevious();

    codeClasses.next();

    codeClasses.next();
    registerTransition({
        begin() {
            translateY = true;
        },
        revert() {
            translateY = false;
        },
    });
    withPrevious();

    codeClasses.next();
    registerTransition({
        begin() {
            scaleY = true;
        },
        revert() {
            scaleY = false;
            chicken.style.removeProperty("--s");
        },
    });
    withPrevious();

    codeClasses.hide();
    stiffness.registerAnimate("right", "middle", 100);
    withPrevious();
    mass.registerAnimate("right", "middle", 200);
    withPrevious();
    damping.registerAnimate("right", "middle", 300);
    withPrevious();

    registerEggTransition();
</script>
