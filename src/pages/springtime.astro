            ins={[2, 3, 4]}
            code={`
class Lerper {
    HALF_LIFE = 100;
    current = 0;
    target = 0;
}
`}
        />
        <Code
            lang="ts"
            ins={[6, 7, 8, 9]}
            code={`
class Lerper {
    HALF_LIFE = 100;
    current = 0;
    target = 0;

    step(delta) {
        const lerp = Math.min(1, 0.5 * delta / HALF_LIFE);
        current += (target - current) * lerp;
    }
}
`}
        />
        <Code
            lang="ts"
            code={`
class Spring {
    current = 0;
    target = 0;
}
`}
        />
        <Code
            lang="ts"
            ins={[5, 6, 7]}
            code={`
class Spring {
    current = 0;
    target = 0;

    step(delta: number) {
        
    }
}
`}
        />
        <Code
            lang="ts"
            ins={[]}
            code={`
class Spring {
    current = 0;
    target = 0;

    stiffness = 100;
    mass = 2;

    step(delta: number) {
        const force = k * (target - current);
        const acceleration = force / mass;
        const velocity = acceleration * delta;
        current += velocity * delta;
    }
}
`}
        />
