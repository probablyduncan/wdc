                lang="typescript"
                ins={{ range: "12-13" }}
                code={`
const x = new Lerper();

window.addEventListener("click", ({ clientX }) => {
    x.target = clientX;
});

let prev = 0;
requestAnimationFrame(function update(time) {
    const delta = time - prev;
    prev = time;

    x.step(delta);
    el.style.setProperty("--x", x.current);

    requestAnimationFrame(update);
});
`}
            />
        </section>
    </Figure>
