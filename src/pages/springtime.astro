class Spring {
    current = 0;
    target = 0;
    velocity = 0;

    stiffness = 100;
    mass = 2;
    damping = 20;

    step(delta: number) {
        const springForce = this.stiffness * (target - current);
        const dampingForce = this.damping * this.velocity;
        const acceleration = (springForce - dampingForce) / this.mass;
        const seconds = delta / 1000;
        this.velocity += acceleration * seconds;
        this.current += velocity * seconds;
    }
}
`}
