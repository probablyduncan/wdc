                lang="typescript"
                ins={{ range: "7-13" }}
                code={`
const x = new Lerper();

window.addEventListener("click", ({ clientX }) => {
    x.target = clientX;
});

let prev = 0;
requestAnimationFrame(function update(time) {
    const delta = time - prev;
    prev = time;

    requestAnimationFrame(update);
});
`}
            />
