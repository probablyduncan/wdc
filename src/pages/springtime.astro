    <Figure x="0.5" y="0.5" class="active">
        <section id="code-uses" slot="figure">
            <Code
                lang="ts"
                ins={{ range: "1" }}
                code={`
const x = new Lerper();
`}
            />
            <Code
                lang="ts"
                ins={{ range: "3-5" }}
                code={`
const x = new Lerper();

window.addEventListener("click", ({ clientX }) => {
    x.target = clientX;
});
`}
            />
            <Code
                lang="ts"
                ins={{ range: "7-13" }}
                code={`
const x = new Lerper();

window.addEventListener("click", ({ clientX }) => {
    x.target = clientX;
});

let prev = 0;
requestAnimationFrame(function update(time) {
    const delta = time - prev;
    prev = time;

    requestAnimationFrame(update);
});
`}
            />
            <Code
                lang="ts"
                ins={{ range: "12-13" }}
                code={`
const x = new Lerper();

window.addEventListener("click", ({ clientX }) => {
    x.target = clientX;
});

let prev = 0;
requestAnimationFrame(function update(time) {
    const delta = time - prev;
    prev = time;

    x.step(delta);
    el.style.setProperty("--x", x.current);

    requestAnimationFrame(update);
});
`}
            />
        </section>
