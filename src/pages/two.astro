---
import Slide from "../components/slide.astro";

export const transitions = ["fade-out"];
---

<Slide>
    <h1 id="fade-out">Pretty neat, huh?</h1>
</Slide>
<script>
    import { registerTransition } from "../lib/slides.client";

    registerTransition("fade-out", {
        begin() {
            document.getElementById("fade-out")!.hidden = true;
        },
        revert() {
            document.getElementById("fade-out")!.hidden = false;
        }
    });
</script>
