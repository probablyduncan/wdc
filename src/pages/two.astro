---
import Slide from "../components/slide.astro";
---

<Slide>
    <h1 id="fade-out">Pretty neat, huh?</h1>
</Slide>
<script>
    import {
        registerElementTransition,
    } from "../lib/slides";

    registerElementTransition<HTMLElement>("#fade-out", (el, op) => {
        el.hidden = (op === "begin");
    });
</script>
