---
import Controls from "../components/controls.astro";
import Control from "../components/control.astro";
---

<!doctype html>
<html lang="en">
    <head></head>
    <body>
        <div id="fps"></div>
        <div id="box"></div>
        <Controls>
            <Control name="damping" type="values" values={[5, 10, 15, 20, 50, 65, 200]} />
            <Control name="stiff" type="checkbox" />
        </Controls>
    </body>
</html>

<style>
    body {
        overflow: clip;
        width: 100vw;
        height: 100vh;
    }
    #box {
        width: 100px;
        aspect-ratio: 1;
        background-color: tomato;
        --x: -100px;
        --y: -100px;
        --r: 0rad;
        transform: translate(calc(var(--x) - 50%), calc(var(--y) - 50%))
            rotate(var(--r));
    }
    #fps {
        position: fixed;
        top: 0;
        right: 0;
        font-family: monospace;
        user-select: none;
    }
</style>

<script>
    import AnimationFrameController from "../lib/animationFrameController";
    import { addControlListener } from "../lib/controlStore";
    import { SpringController } from "../lib/interpolationController";

    const box = document.getElementById("box")!;
    const fps = document.getElementById("fps")!;

    const x = new SpringController();
    const y = new SpringController();

    // set starting position
    x.current = x.target = y.current = y.target = -100;

    function getRotation() {
        // max.rotation
        const max = Math.PI / 8;
        // [-180,180] where top is 0, left is negative, right is positive
        const angleToCurrent = Math.atan2(
            x.target - x.current,
            y.current - y.target,
        );
        // [-1,1] where topleft and bottomright +1, topright and bottomleft -1, and left/right/top/bottom 0
        const angleFactor = -Math.sin(angleToCurrent * 2);
        // [0,1] velocities get big (~1000 sometimes), so we have to scale it down a lot
        const velocityFactor = Math.min(
            Math.abs((x.velocity * y.velocity) / 2000000),
            1,
        );
        return max * angleFactor * velocityFactor;
    }

    const animationController = new AnimationFrameController((deltaMS) => {
        box.style.setProperty("--x", x.step(deltaMS) + "px");
        box.style.setProperty("--y", y.step(deltaMS) + "px");
        box.style.setProperty("--r", getRotation() + "rad");
        fps.innerText = (1000 / deltaMS).toFixed() + " FPS ";
        return true;
    });

    animationController.playIfPaused();

    window.addEventListener("mousemove", (e) => {
        x.target = e.clientX;
        y.target = e.clientY;
    });

    document.addEventListener("keypress", ({ key }) => {
        if (key === " ") {
            animationController.toggle();
        }
    });

    addControlListener<number>("damping", (value) => {
        x.options.damping = value;
        y.options.damping = value;
    });
    
    addControlListener<boolean>("stiff", (value) => {
        x.options.stiffness = value ? 20 : 120;
        y.options.stiffness = value ? 20 : 120;
    });
</script>
