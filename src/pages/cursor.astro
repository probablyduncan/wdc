---
import { Code } from "astro-expressive-code/components";
import Slide from "../components/slide.astro";
import Figure from "../components/figure.astro";

const htmlFinal = `
<img id="egg" alt="my best egg"
    src="egg.webp" draggable="false" />
`;

const cssFinal = `
#egg {
    --x: 0;
    --y: 0;
    transform: translate(var(--x), var(--y));

    position: fixed;
    width: 5rem;
    pointer-events: none;
    user-select: none;
}

@media (prefers-reduced-motion: reduce) {
    #egg {
        display: none;
    }
}
`;

const tsFinal = `
const egg = document.getElementById("egg")!;

type Position = { x: number, y: number }
const current: Position = { x: 0, y: 0 };
const target: Position = { x: 0, y: 0 };

const HALF_LIFE = 0.005; // in milliseconds

window.addEventListener("mousemove", (e) => {
    target.x = e.clientX;
    target.y = e.clientY;
});

let oldOldOld: DOMHighResTimeStamp;
requestAnimationFrame((nowNowNow: DOMHighResTimeStamp) => {
    oldOldOld = nowNowNow;
    requestAnimationFrame(moveEgg);
});

function moveEgg(nowNowNow: DOMHighResTimeStamp) {
    const deltaMS = nowNowNow - oldOldOld;
    oldOldOld = nowNowNow;

    const lerpValue = Math.min(1, 0.5 * deltaMS / HALF_LIFE);
    current.x += (target.x - current.x) * lerpValue;
    current.y += (target.y - current.y) * lerpValue;

    egg.style.setProperty("--x", current.x + "px");
    egg.style.setProperty("--y", current.y + "px");

    requestAnimationFrame(moveEgg);
}
`;
---

<Slide prev="index">
