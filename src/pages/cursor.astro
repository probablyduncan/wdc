<style>
    #egg {
        position: fixed;
        inset: 0;

        &:not(.nothing) {
            display: none;
        }

        &.sized {
            width: 5rem;
        }

        z-index: 1;
        &.front {
            z-index: 50;
        }

        transform: translate(var(--x, 0px), var(--y, 0px));
        &.center {
            transform: translate(
                calc(var(--x, 0px) - 50%),
                calc(var(--y, 0px) - 50%)
            );
            transition: opacity 0.4s;
            opacity: calc(1 - var(--over-code, 0) * 0.5);
        }

        &.no-pointer {
            pointer-events: none;
            user-select: none;
            -webkit-user-drag: none;
            -webkit-user-select: none;
        }

        &.no-motion {
            @media (prefers-reduced-motion: reduce) {
                display: none;
            }
        }
    }

