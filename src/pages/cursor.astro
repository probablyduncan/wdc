</style>
<script>
    import {
        addConstControl,
        addLiveDisplay,
        getChildTransitions,
    } from "../lib/codeBlockHelpers";
    import {
        SpringController,
        type SpringOptions,
    } from "../lib/interpolationController";
    import {
        registerClassTransition,
        registerOneTimeTransition,
        registerRafTransition,
        withPrevious,
    } from "../lib/slides";
    import { registerTransition } from "../lib/slides";

    const egg = document.getElementById("egg")!;

    const current = { x: 0, y: 0 };
    const target = { x: 0, y: 0 };
    const prevTarget = { x: 0, y: 0 };
    window.addEventListener("mousemove", (e) => {
        target.x = e.clientX;
        target.y = e.clientY;
    });

    function updateEggPos(pos: { x: number; y: number }) {
        egg.style.setProperty("--egg-x", pos.x.toFixed(2) + "px");
        egg.style.setProperty("--egg-y", pos.y.toFixed(2) + "px");
    }

    function resetEggPos() {
        egg.style.removeProperty("--egg-x");
        egg.style.removeProperty("--egg-y");
    }

    const animationOptions: {
        lerpType:
            | "none"
            | "instant"
            | "current-not-updating"
            | "current-just-bottom-right"
            | "constant-speed-positive-only"
            | "constant-speed"
            | "constant-speed-trig"
            | "basic-half"
            | "half-no-clamp"
            | "half";
        log: "none" | "timestamp" | "delta";
        actII: "dormant" | "ready" | "active";
    } = {
        lerpType: "instant",
        log: "none",
        actII: "dormant",
    };

    function animationOptionTransition<
        TKey extends keyof typeof animationOptions,
    >(key: TKey, value: (typeof animationOptions)[TKey]) {
        let prevValue: any;
        registerTransition({
            begin() {
                prevValue = animationOptions[key];
                animationOptions[key] = value;
            },
            revert() {
                animationOptions[key] = prevValue;
            },
        });
    }

    function toggleEggClass(className: string, remove: boolean = false) {
        const beginAction = remove ? "remove" : "add";
        const revertAction = remove ? "add" : "remove";
        registerTransition({
            begin() {
                egg.classList[beginAction](className);
            },
            revert() {
                egg.classList[revertAction](className);
            },
        });
    }

    const pxPerFrameControl = addConstControl(
        "const PIXELS_PER_FRAME =",
        [-20, -5, -2, -1, 0, 1, 2, 5, 20],
        { startInlineInputsHidden: true },
    );

    const halfLifeBasicControl = addConstControl(
        "const LERP_VALUE =",
        [0, 0.005, 0.05, 0.5],
    );

    const halfLifeControl = addConstControl(
        "const HALF_LIFE =",
        [0, 5, 20, 50, 100, 200, 500, 1000, 2000],
    );

    const liveGlitteringNow = addLiveDisplay("TIMESTAMP", "0.0");
    const liveDelta = addLiveDisplay("DELTA", "00.0");
    const liveFPS = addLiveDisplay("FPS", "00.0");
    const liveHalfLifeLerp = addLiveDisplay("HALF_LIFE_LERP", "0.0");

    const html = getChildTransitions("html", ".expressive-code");
    const css = getChildTransitions("css", ".expressive-code");
    const ts = getChildTransitions("ts", ".expressive-code");

    function getCenter(rect: DOMRect) {
        return {
            x: rect.x + rect.width / 2,
            y: rect.y + rect.height / 2,
        };
    }

    const actI = [...document.querySelectorAll<HTMLElement>(".act-i")].map(
        (el) => {
            const springOptions: SpringOptions = {
                mass: 2,
                damping: 10,
                stiffness: 50,
            };
            const x = new SpringController(springOptions);
            const y = new SpringController(springOptions);
            const r = new SpringController(springOptions);
            return {
                setup(mousePos: { x: number; y: number }) {
                    const thisPos = getCenter(el.getBoundingClientRect());
                    const angleFromMouse = Math.atan2(
                        thisPos.y - mousePos.y,
                        thisPos.x - mousePos.x,
                    );
                    x.target =
                        Math.cos(angleFromMouse) *
                        window.innerWidth *
                        Math.SQRT2;
                    y.target =
                        Math.sin(angleFromMouse) *
                        window.innerHeight *
                        Math.SQRT2;
                    r.velocity = Math.random() * 4 - 2;
                },
                step(delta: number) {
                    x.step(delta);
                    y.step(delta);
                    r.step(delta);
                    el.style.setProperty(
                        "--act-x",
                        x.current.toFixed(2) + "px",
                    );
                    el.style.setProperty(
                        "--act-y",
                        y.current.toFixed(2) + "px",
                    );
                    el.style.setProperty(
                        "--act-r",
                        r.current.toFixed(6) + "rad",
                    );
                },
                reset() {
                    x.current = x.target = 0;
                    y.current = y.target = 0;
                    r.current = r.target = 0;
                    el.style.removeProperty("--act-x");
                    el.style.removeProperty("--act-y");
                    el.style.removeProperty("--act-r");
                },
            };
        },
    );

    const actII = (() => {
        const h1 = document.querySelector<HTMLHeadingElement>("#act-ii h1")!;
        const h1SpringOptions: Partial<SpringOptions> = {
            mass: 4,
            damping: 10,
        };
        const h1x = new SpringController(h1SpringOptions);
        const h1y = new SpringController(h1SpringOptions);
        const h1r = new SpringController();
        function setH1Props() {
            h1.style.setProperty("--act-x", h1x.current.toFixed(2) + "px");
            h1.style.setProperty("--act-y", h1y.current.toFixed(2) + "px");
            h1.style.setProperty("--act-r", h1r.current.toFixed(6) + "rad");
        }

        const h2 = document.querySelector<HTMLHeadingElement>("#act-ii h2")!;
        const h2SpringOptions: SpringOptions = {
            mass: 2,
            damping: 6,
            stiffness: 80,
        };
        const h2x = new SpringController(h2SpringOptions);
        const h2y = new SpringController(h2SpringOptions);
        const h2r = new SpringController();
        function setH2Props() {
            h2.style.setProperty("--act-x", h2x.current.toFixed(2) + "px");
            h2.style.setProperty("--act-y", h2y.current.toFixed(2) + "px");
            h2.style.setProperty("--act-r", h2r.current.toFixed(6) + "rad");
        }

        let h2SetupTimeoutId: NodeJS.Timeout | undefined;

        return {
            setup(
                mouse: { x: number; y: number },
                mouseDelta: { x: number; y: number },
            ) {
                const center = getCenter(
                    h1.parentElement!.getBoundingClientRect(),
                );
                const mouseToCenterAngle = Math.atan2(
                    mouse.y - center.y,
                    mouse.x - center.x,
                );
                const mouseDeltaAngle = Math.atan2(mouseDelta.y, mouseDelta.x);

                const mouseDirectionVector = {
                    x: Math.cos(mouseDeltaAngle),
                    y: Math.sin(mouseDeltaAngle),
                };

                const mouseToCenterVector = {
                    x: Math.cos(mouseToCenterAngle),
                    y: Math.sin(mouseToCenterAngle),
                };

                h1x.current = mouseToCenterVector.x * window.innerWidth;
                h1y.current = mouseToCenterVector.y * window.innerHeight;
                h1x.velocity = mouseDirectionVector.x * 5000;
                h1y.velocity = (mouseDirectionVector.y * 5000) / 2;
                h1r.velocity = mouseDeltaAngle;
                setH1Props();
                h1.classList.add("active");

                if (h2SetupTimeoutId) {
                    clearTimeout(h2SetupTimeoutId);
                }

                h2SetupTimeoutId = setTimeout(() => {
                    h2SetupTimeoutId = undefined;
                    h2x.current = mouseToCenterVector.x * window.innerWidth;
                    h2y.current = mouseToCenterVector.y * window.innerHeight;
                    h2x.velocity = mouseDirectionVector.x * 5000;
                    h2y.velocity = (mouseDirectionVector.y * 5000) / 8;
                    h2r.velocity = mouseDeltaAngle * 2;
                    setH2Props();
                    h2.classList.add("active");
                }, 2000);
            },
            step(delta: number) {
                h1x.step(delta);
                h1y.step(delta);
                h1r.step(delta);

                h2x.step(delta);
                h2y.step(delta);
                h2r.step(delta);

                setH1Props();
                setH2Props();
            },
            reset() {
                h1.classList.remove("active");
                h1x.current = h1x.target = 0;
                h1y.current = h1y.target = 0;
                h1r.current = h1r.target = 0;
                h1.style.removeProperty("--act-x");
                h1.style.removeProperty("--act-y");
                h1.style.removeProperty("--act-r");
                h2.classList.remove("active");
                h2x.current = h2x.target = 0;
                h2y.current = h2y.target = 0;
                h2r.current = h2r.target = 0;
                h2.style.removeProperty("--act-x");
                h2.style.removeProperty("--act-y");
                h2.style.removeProperty("--act-r");

                if (h2SetupTimeoutId) {
                    clearTimeout(h2SetupTimeoutId);
                }
            },
        };
    })();

    const actIIOptions = {
        triggerMargin: 100,
        triggerMinPxPerMS: 0.8,
        animationSpeed: 0.5,
    };

    function resetActIITransition() {
        actI.forEach((el) => el.reset());
        actII.reset();
        prevTarget.x = prevTarget.y = 0;
        egg.classList.remove("away");
    }

    let fpsThrottlePrevTime = 0;
    const fpsThrottle = document.querySelector<HTMLInputElement>(
        `input[name="fps-throttle"]`,
    );
    let maxFPS = Infinity;
    const updateMaxFPS = () =>
        (maxFPS = parseInt(
            fpsThrottle?.getAttribute("aria-valuetext") ?? "Infinity",
        ));
    updateMaxFPS();
    fpsThrottle?.addEventListener("input", updateMaxFPS);

    const raf = registerRafTransition({}, ({ timestamp, delta }) => {
        const throttledDelta = timestamp - fpsThrottlePrevTime;

        const fps = 1000 / throttledDelta;
        if (fps > maxFPS) {
            return true;
        }

        liveDelta.set(throttledDelta.toFixed(1));
        liveGlitteringNow.set(timestamp.toFixed(1));
        liveFPS.set(fps.toFixed(1).padStart(5, ""));

        fpsThrottlePrevTime = timestamp;

        switch (animationOptions.log) {
            case "timestamp":
                console.log(timestamp);
                break;
            case "delta":
                console.log(throttledDelta);
                break;
        }

        switch (animationOptions.lerpType) {
            case "instant":
                current.x = target.x;
                current.y = target.y;
                break;
            case "current-not-updating":
                break;
            case "current-just-bottom-right":
                current.x += pxPerFrameControl.get();
                current.y += pxPerFrameControl.get();
                break;
            case "constant-speed-positive-only":
                current.x = Math.min(
                    target.x,
                    current.x + pxPerFrameControl.get(),
                );
                current.y = Math.min(
                    target.y,
                    current.y + pxPerFrameControl.get(),
                );
                break;
            case "constant-speed":
                const distanceX = target.x - current.x;
                const distanceY = target.y - current.y;
                current.x +=
                    Math.min(pxPerFrameControl.get(), Math.abs(distanceX)) *
                    Math.sign(distanceX);
                current.y +=
                    Math.min(pxPerFrameControl.get(), Math.abs(distanceY)) *
                    Math.sign(distanceY);
                break;
            case "constant-speed-trig":
                const distanceToTarget = {
                    x: target.x - current.x,
                    y: target.y - current.y,
                };
                const angleToTarget = Math.atan2(
                    distanceToTarget.y,
                    distanceToTarget.x,
                );
                const distanceToTravel = {
                    x: Math.cos(angleToTarget) * pxPerFrameControl.get(),
                    y: Math.sin(angleToTarget) * pxPerFrameControl.get(),
                };
                const distanceToTravelFinalFinalNoEdits = {
                    x: Math.min(
                        Math.abs(distanceToTarget.x),
                        Math.abs(distanceToTravel.x),
                    ),
                    y: Math.min(
                        Math.abs(distanceToTarget.y),
                        Math.abs(distanceToTravel.y),
                    ),
                };
                current.x +=
                    distanceToTravelFinalFinalNoEdits.x *
                    Math.sign(distanceToTarget.x);
                current.y +=
                    distanceToTravelFinalFinalNoEdits.y *
                    Math.sign(distanceToTarget.y);
                break;
            case "basic-half":
                current.x +=
                    (target.x - current.x) * halfLifeBasicControl.get();
                current.y +=
                    (target.y - current.y) * halfLifeBasicControl.get();
                break;
            case "half-no-clamp":
                const lerpValue =
                    (0.5 * throttledDelta) / halfLifeControl.get();
                liveHalfLifeLerp.set(lerpValue.toFixed(3));
                current.x += (target.x - current.x) * lerpValue;
                current.y += (target.y - current.y) * lerpValue;
                break;
            case "half":
                const lerpValueClamped = Math.min(
                    1,
                    (0.5 * throttledDelta) / halfLifeControl.get(),
                );
                liveHalfLifeLerp.set(lerpValueClamped.toFixed(3));
                current.x += (target.x - current.x) * lerpValueClamped;
                current.y += (target.y - current.y) * lerpValueClamped;
                break;
        }

        updateEggPos(current);

        switch (animationOptions.actII) {
            case "ready":
                const targetDelta = {
                    x: target.x - prevTarget.x,
                    y: target.y - prevTarget.y,
                };
                prevTarget.x = target.x;
                prevTarget.y = target.y;

                // begin if mouse is within the margin from the right side of the screen,
                // is traveling faster than the min speed, and is going to the left
                if (
                    targetDelta.x < 0 &&
                    target.x > window.innerWidth - actIIOptions.triggerMargin &&
                    Math.abs(targetDelta.x / delta) >
                        actIIOptions.triggerMinPxPerMS
                ) {
                    animationOptions.actII = "active";
                    actII.setup(target, targetDelta);
                    actI.forEach((el) => el.setup(target));
                    egg.classList.add("away");

                    registerOneTimeTransition(
                        "revert",
                        () => {
                            resetActIITransition();
                            animationOptions.actII = "ready";
                        },
                        true,
                    );
                }
                break;
            case "active":
                const newDelta = delta * actIIOptions.animationSpeed;
                actII.step(newDelta);
                actI.forEach((el) => el.step(newDelta));
                break;
            case "dormant":
                if (prevTarget.x !== 0) {
                    resetActIITransition();
                }
                break;
        }

        return true;
    });

    // egg appears
    html.next();
    toggleEggClass("nothing");
    withPrevious();

    // add some css
    css.next();

    // oops, add id
    html.next();
    toggleEggClass("sized");
    withPrevious();

    // now try first simple mousemove
    raf.registerStart();
    ts.next();
    withPrevious();
    // when we revert before this point, should reset egg pos
    registerTransition({
        begin() {
            target.x = 0;
            target.y = 0;
        },
        revert: resetEggPos,
    });
    withPrevious();
    html.next();
    withPrevious();

    // remove style updates from mousemove
    animationOptionTransition("lerpType", "none");
    ts.next();
    withPrevious();

    // add moveEgg function
    ts.next();

    for (let i = 0; i < 3; i++) {
        // call moveEgg once, update position once
        function sync() {
            current.x = target.x;
            current.y = target.y;
        }
        registerTransition({
            begin: sync,
            revert() {},
        });
        ts.next();
        withPrevious();
    }

    // make recursive, start loop
    animationOptionTransition("lerpType", "instant");
    ts.next();
    withPrevious();

    // z index, move egg to front
    css.next();
    ts.next();
    withPrevious();
    toggleEggClass("front");
    withPrevious();

    // pointer events, draggable, etc
    html.next();
    css.next();
    withPrevious();
    toggleEggClass("no-pointer");
    withPrevious();
    registerTransition({
        begin() {
            egg.draggable = false;
        },
        revert() {
            egg.draggable = true;
        },
    });
    withPrevious();

    // center on cursor using ts
    ts.next();
    toggleEggClass("center");
    withPrevious();
    css.next();
    withPrevious();
    html.next();
    withPrevious();

    // but we want to use css props
    // add css translate, set props in ts
    css.next();
    ts.next();
    withPrevious();

    // or use variables with defaults?
    css.next();
    ts.next();
    withPrevious();

    // show wcaglette popup
    registerClassTransition("#wcaglette", "active");

    // add reduced motion css
    toggleEggClass("no-motion");
    css.next();
    withPrevious();

    // hide wcaglette popup, condense css
    registerClassTransition("#wcaglette", "active", "remove");
    css.next();
    withPrevious();

    // so now we get to lerping! what fun

    // add current, but we're not updating it yet
    animationOptionTransition("lerpType", "current-not-updating");
    ts.next();
    withPrevious();

    // collapse stuff on top
    ts.next();

    // go towards bottom right
    animationOptionTransition("lerpType", "current-just-bottom-right");
    ts.next();
    withPrevious();
    registerTransition({
        begin() {
            pxPerFrameControl.show();
        },
        revert() {
            pxPerFrameControl.hide();
            pxPerFrameControl.reset();
        },
    });
    withPrevious();

    // go towards current every frame, but only positive
    animationOptionTransition("lerpType", "constant-speed-positive-only");
    ts.next();
    withPrevious();
    registerTransition(() => {
        let prev = 1;
        return {
            begin() {
                if (pxPerFrameControl.get() <= 0) {
                    pxPerFrameControl.set(
                        prev as ReturnType<(typeof pxPerFrameControl)["get"]>,
                    );
                }
            },
            revert() {
                prev = pxPerFrameControl.get();
                pxPerFrameControl.set(0);
            },
        };
    });
    withPrevious();

    ts.next();

    // go towards current every frame
    animationOptionTransition("lerpType", "constant-speed");
    ts.next();
    withPrevious();

    // build up trig
    ts.next();
    ts.next();
    ts.next();
    animationOptionTransition("lerpType", "constant-speed-trig");
    withPrevious();

    // but this is kind of boring anyway, can we do something more interesting?
    // if we lerp proportionally it's a lot easier, we can do it per axis

    ts.next();
    animationOptionTransition("lerpType", "none");
    withPrevious();

    registerClassTransition("#zeno", "active");
    registerClassTransition("#dichotomy", "active");

    registerClassTransition("#zeno", "active", "remove");
    registerClassTransition("#dichotomy", "active", "remove");
    withPrevious();

    // add lerp calculation
    ts.next();
    animationOptionTransition("lerpType", "basic-half");
    withPrevious();

    registerClassTransition("#lerp-with-apples", "active");

    // add lerp slider
    registerClassTransition("#lerp-with-apples", "active", "remove");
    ts.next();
    withPrevious();

    // now show FPS!!
    registerClassTransition("#fps-figure", "active");

    // show throttle!
    registerClassTransition("#fps-throttle", "active");
    registerTransition({
        begin() {},
        revert() {
            maxFPS = Infinity;
        },
    });
    withPrevious();

    // something I've been keeping from you
    // the callback has an argument. I'm convinced!
    // gives you the time of day
    // add timestamp arg
    registerClassTransition("#w3c-raf", "active");
    registerClassTransition("#w3c-raf", "active", "remove");
    ts.next();
    withPrevious();
    animationOptionTransition("log", "timestamp");
    withPrevious();

    // calculate/log delta
    ts.next();
    animationOptionTransition("log", "none");
    withPrevious();
    animationOptionTransition("log", "delta");
    withPrevious();

    // ok no more logging
    ts.next();
    animationOptionTransition("log", "none");
    withPrevious();

    // add half life stuff
    ts.next();
    animationOptionTransition("lerpType", "half-no-clamp");
    withPrevious();

    // half life larp
    registerClassTransition("#half-life-larp", "active");
    registerClassTransition("#half-life-larp", "active", "remove");

    ts.next();
    animationOptionTransition("lerpType", "half");
    withPrevious();

    registerClassTransition(`#spring-garlic`);
    registerClassTransition(`#spring-tigger`);
    registerClassTransition(`#spring-dog`);
    registerClassTransition(`#spring-slinky`);
    animationOptionTransition("actII", "ready");
    withPrevious();

    // something's missing in my step...

    // we’ve got a long winter ahead of us
    // good thing it’s time for
</script>
