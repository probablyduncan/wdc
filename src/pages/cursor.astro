</Slide>
<style>
    #egg {
        position: fixed;
        inset: 0;

        &:not(.nothing) {
            display: none;
        }

        &.sized {
            width: 5rem;
        }

        z-index: 1;
        &.front {
            z-index: 50;
        }

        transform: translate(var(--x, 0px), var(--y, 0px));
        &.center {
            transform: translate(
                calc(var(--x, 0px) - 50%),
                calc(var(--y, 0px) - 50%)
            );
        }

        &.no-pointer {
            transition: opacity 0.4s;
            pointer-events: none;
            user-select: none;
            -webkit-user-drag: none;
            -webkit-user-select: none;
        }

        &.no-motion {
            @media (prefers-reduced-motion: reduce) {
                display: none;
            }
        }
    }

    :global(body:has(.expressive-code.active:hover)) #egg.no-pointer {
        opacity: 0.4;
    }

    #left {
        position: fixed;
        top: 2ch;
        left: 2ch;
        z-index: 3;
    }

    #right {
        position: fixed;
        top: 2ch;
        bottom: 2ch;
        right: 2ch;
        display: flex;
        flex-flow: column;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2ch;
        z-index: 3;
    }

    #ts :global(.expressive-code) {
        max-width: calc(50vw - 3ch);
    }

    #css :global(.expressive-code) {
        /* max-width: min(50ch, 50vw - 3ch); */
    }

    :global(.expressive-code) {
        &:not(.active) {
            display: none;
        }
    }

    #css :global(.code) {
        /* width: 45ch; */
    }
</style>
<script>
    import { addConstControl } from "../lib/addConstControl";
    import { LerpController } from "../lib/interpolationController";
    import { registerClassTransition, registerRafTransition, withPrevious } from "../lib/slides";
    import { registerTransition } from "../lib/slides";

    const egg = document.getElementById("egg")!;

    const target = { x: 0, y: 0 };
    window.addEventListener("mousemove", (e) => {
        target.x = e.clientX;
        target.y = e.clientY;
    });

    const animationOptions: {
        lerpType:
            | "half"
            | "instant"
            | "constant-speed"
            | "constant-speed-positive-only";
    } = {
        lerpType: "instant",
    };

    function toggleAnimationOption<TKey extends keyof typeof animationOptions>(
        key: TKey,
        value: (typeof animationOptions)[TKey],
    ) {
        let prevValue: any;
        registerTransition({
            begin() {
                prevValue = animationOptions[key];
                animationOptions[key] = value;
            },
            revert() {
                animationOptions[key] = prevValue;
            },
        });
    }

    function toggleEggClass(className: string, remove: boolean = false) {
        const beginAction = remove ? "remove" : "add";
        const revertAction = remove ? "add" : "remove";
        registerTransition({
            begin() {
                egg.classList[beginAction](className);
            },
            revert() {
                egg.classList[revertAction](className);
            },
        });
    }

    const raf = registerRafTransition(
        { current: { x: 0, y: 0 } },
        ({ delta, state: { current } }) => {
            if (animationOptions.lerpType === "instant") {
                egg.style.setProperty("--x", target.x + "px");
                egg.style.setProperty("--y", target.y + "px");
                return true;
            }

            if (animationOptions.lerpType === "half") {
                const lerpValue = Math.min(1, (0.5 * delta) / 100);
                current.x += (target.x - current.x) * lerpValue;
                current.y += (target.y - current.y) * lerpValue;
                egg.style.setProperty("--x", current.x + "px");
                egg.style.setProperty("--y", current.y + "px");
            }

            return true;
        },
    );

    const { html, css, ts } = (() => {
        const langs = ["html", "css", "ts"] as const;
        type Lang = (typeof langs)[number];
        type CodeBlockAction = "next" | "show" | "hide";
        return langs.reduce(
            (map, lang) => {
                const wrapperEl = document.getElementById(lang);
                if (!wrapperEl) return map;

                const codeBlockEls = [
                    ...wrapperEl.querySelectorAll<HTMLElement>(
                        ".expressive-code",
                    ),
                ];

                let index = codeBlockEls.findIndex((el) =>
                    el.classList.contains("active"),
                );

                function toggleCurrent(type: "remove" | "add") {
                    if (index > -1 && index < codeBlockEls.length) {
                        const currentEl = codeBlockEls[index];
                        currentEl.classList[type]("active");

                        // reset scroll?
                        if (type === "add") {
                            currentEl
                                .querySelector<HTMLPreElement>(`pre`)
                                ?.scrollTo({ behavior: "instant", left: 0 });
                        }
                    }
                }

                function isHidden() {
                    if (index > -1 && index < codeBlockEls.length) {
                        return !codeBlockEls[index].classList.contains(
                            "active",
                        );
                    }

                    return false;
                }

                function registerNext() {
                    let hiddenOnBegin = false;
                    registerTransition({
                        begin() {
                            hiddenOnBegin = isHidden();
                            const atEnd = index >= codeBlockEls.length - 1;

                            if (!hiddenOnBegin && !atEnd) {
                                toggleCurrent("remove");
                            }

                            index++;
                            if (!atEnd) {
                                toggleCurrent("add");
                            }
                        },
                        revert() {
                            toggleCurrent("remove");
                            index--;
                            if (!hiddenOnBegin) {
                                toggleCurrent("add");
                            }
                        },
                    });
                }

                function registerHide() {
                    let hiddenOnBegin = false;
                    registerTransition({
                        begin() {
                            hiddenOnBegin = isHidden();
                            toggleCurrent("remove");
                        },
                        revert() {
                            if (!hiddenOnBegin) {
                                toggleCurrent("add");
                            }
                        },
                    });
                }

                function registerShow() {
                    let hiddenOnBegin = false;
                    registerTransition({
                        begin() {
                            hiddenOnBegin = isHidden();
                            toggleCurrent("add");
                        },
                        revert() {
                            if (hiddenOnBegin) {
                                toggleCurrent("remove");
                            }
                        },
                    });
                }

                map[lang] = {
                    hide: registerHide,
                    show: registerShow,
                    next: registerNext,
                };

                return map;
            },
            {} as Record<Lang, Record<CodeBlockAction, () => void>>,
        );
    })();

    // egg appears
    html.next();
    toggleEggClass("nothing");
    withPrevious();

    // add some css
    css.next();

    // oops, add id
    html.next();
    toggleEggClass("sized");
    withPrevious();

    // now try first simple mousemove
    raf.registerStart();
    ts.next();
    withPrevious();
    registerTransition({
        begin: () => {},
        revert() {
            // when we revert before this point, should reset egg pos
            egg.style.removeProperty("--x");
            egg.style.removeProperty("--y");
        },
    });
    withPrevious();
    html.next();
    withPrevious();

    // remove style updates from mousemove
    raf.registerEnd();
    ts.next();
    withPrevious();

    // add raf loop
    ts.next();
    raf.registerStart();
    withPrevious();

    // z index, move egg to front
    css.next();
    ts.next();
    withPrevious();
    toggleEggClass("front");
    withPrevious();

    // pointer events, draggable, etc
    html.next();
    css.next();
    withPrevious();
    toggleEggClass("no-pointer");
    withPrevious();
    registerTransition({
        begin() {
            egg.draggable = false;
        },
        revert() {
            egg.draggable = true;
        },
    });
    withPrevious();

    // center on cursor using ts
    ts.next();
    toggleEggClass("center");
    withPrevious();
    css.next();
    withPrevious();
    html.next();
    withPrevious();

    // but we want to use css props
    css.next();

    // add css transform, set props in ts
    css.next();
    ts.next();
    withPrevious();

    // or use variables with defaults?
    css.next();
    
    // show wcaglette popup
    registerClassTransition("#wcaglette");
    css.next();
    withPrevious();
    
    // hide wcaglette popup, add reduced motion css
    registerClassTransition("#wcaglette", "active", "remove");
    toggleEggClass("no-motion");
    withPrevious();
    css.next();
    withPrevious();

    css.next();

    // last thing we want to do before making the animation better
    // wcaglette

    // test animation options?
    // ts.next();
    // toggleAnimationOption("lerpType", "half");
    // withPrevious();

    // ------------------------------------------------------------------------------

    const x = new LerpController();
    const y = new LerpController();

    window.addEventListener("mousemove", ({ clientX, clientY }) => {
        x.target = clientX;
        y.target = clientY;
    });

    const halfLifeControl = addConstControl("HALF_LIFE", [
        "0",
        "5",
        "20",
        "50",
        "100",
        "200",
        "500",
        "1000",
        "2000",
    ]);

    halfLifeControl.listen((value) => {
        const num = parseFloat(value);
        x.halfLife = num;
        y.halfLife = num;
    });

    let prev: DOMHighResTimeStamp;
    requestAnimationFrame((thisFrameTimeStamp: DOMHighResTimeStamp) => {
        prev = thisFrameTimeStamp;
        // requestAnimationFrame(moveEgg);
    });

    function moveEgg(time: DOMHighResTimeStamp) {
        const delta = time - prev;
        prev = time;
        egg.style.setProperty("--x", x.step(delta).toFixed() + "px");
        egg.style.setProperty("--y", y.step(delta).toFixed() + "px");
        requestAnimationFrame(moveEgg);
    }
</script>
