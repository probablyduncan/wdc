            <Code
                lang="typescript"
                ins={[/min\((PIXELS.*[xy]\))/g, /\* Math\.sign.*\)/g]}
                code={`
const egg = document.getElementById("egg")!;

const target: { x: 0, y: 0 };
const current: { x: 0, y: 0 };

document.addEventListener("mousemove", (e) => {
    target.x = e.clientX;
    target.y = e.clientY;
});

const PIXELS_PER_FRAME = 0;

requestAnimationFrame(function moveEgg() {
    const distanceToTarget = {
        x: target.x - current.x,
        y: target.y - current.y,
    };

    current.x += Math.min(PIXELS_PER_FRAME, Math.abs(distanceToTarget.x))
        * Math.sign(distanceToTarget.x);
    current.y += Math.min(PIXELS_PER_FRAME, Math.abs(distanceToTarget.y))
        * Math.sign(distanceToTarget.y);

    egg.style.setProperty("--x", current.x + "px");
    egg.style.setProperty("--y", current.y + "px");

    requestAnimationFrame(moveEgg);
});
`}
