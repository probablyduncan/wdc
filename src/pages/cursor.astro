---
import { Code } from "astro-expressive-code/components";
import Slide from "../components/slide.astro";
import Figure from "../components/figure.astro";

const e = [
    `
const egg = document.getElementById("egg")!;

type Position = { x: number, y: number }
const current: Position = { x: 0, y: 0 };
const target: Position = { x: 0, y: 0 };

const PIXELS_PER_MS = 1;

window.addEventListener("mousemove", (e) => {
    target.x = e.clientX;
    target.y = e.clientY;
});

let lastFrameTimeStamp: DOMHighResTimeStamp;
requestAnimationFrame((thisFrameTimeStamp: DOMHighResTimeStamp) => {
    lastFrameTimeStamp = thisFrameTimeStamp;
    requestAnimationFrame(moveEgg);
});

function moveEgg(thisFrameTimeStamp: DOMHighResTimeStamp) {
    const elapsedMS = thisFrameTimeStamp - lastFrameTimeStamp;
    lastFrameTimeStamp = thisFrameTimeStamp;

    const distanceToTravel = elapsedMS * PIXELS_PER_MS;
    current.x += Math.min(distanceToTravel, target.x - current.x);
    current.x += Math.min(distanceToTravel, target.y - current.y);

    egg.style.setProperty("--x", Math.round(current.x) + "px");
    egg.style.setProperty("--y", Math.round(current.y) + "px");

    requestAnimationFrame(moveEgg);
}
`,
    `

`,
];
---

<Slide prev="index">
    <div id="html-css-code">
        <Code
            lang="html"
            code={`
<img id="egg" alt="my best egg"
    src="egg.webp" draggable="false" />`}
        />
        <Code
            lang="css"
            collapse={["6-9", "12-16"]}
            collapseStyle="collapsible-start"
            code={`
#egg {
    --x: 0;
    --y: 0;
    transform: translate(var(--x), var(--y));

    position: fixed;
    width: 5rem;
    pointer-events: none;
    user-select: none;
}

@media (prefers-reduced-motion: reduce) {
    #egg {
        display: none;
    }
}
    `}
        />
    </div>
    <div id="js-code">
        <Code lang="typescript" code={e[0]} />
    </div>
    <img id="egg" src="/images/egg.webp" alt="my best egg" />
    <Figure
        id="cameron"
        src="/images/www.cameronsworld.net.png"
        x="0.5"
        y="0.5"
        class="active"
        figure="5"
        width="50rem"
    >
        a visage[4] of the early web. This is a screenshot from `cameronsworld.net`, a postmodern adventure of the soul through gif art.[5]
    </Figure>
</Slide>
<style>
    :global(:root) {
        /* cursor: none; */
    }
    #egg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        user-select: none;

        @media (prefers-reduced-motion: reduce) {
            display: none;
        }

        width: 5rem;

        --x: 0px;
        --y: 0px;
        transform: translate(calc(var(--x) - 50%), calc(var(--y) - 50%));

        transition: opacity 0.4s;
    }

    #html-css-code {
        position: fixed;
        top: 2ch;
        right: 2ch;
        display: flex;
        flex-flow: column;
        gap: 2ch;
    }

    #js-code {
        position: fixed;
        top: 2ch;
        left: 2ch;
    }

    :global(body:has(.expressive-code:hover)) #egg {
        opacity: 0.4;
    }
</style>
<script>
    import { addConstControl } from "../lib/addConstControl";

    const egg = document.getElementById("egg")!;
    type Pos = { x: number; y: number };
    const target: Pos = { x: 0, y: 0 };
    const current: Pos = { x: 0, y: 0 };

    window.addEventListener("mousemove", ({ clientX, clientY }) => {
        target.x = clientX;
        target.y = clientY;
    });

    const pixelsPerMS = addConstControl("PIXELS_PER_MS", [
        "0.0675",
        "0.125",
        "0.25",
        "0.5",
        "1",
        "2",
        "4",
        "8",
        "16",
        "32",
    ]);

    let prev: DOMHighResTimeStamp | undefined = undefined;

    let lastFrameTimeStamp: DOMHighResTimeStamp;
    requestAnimationFrame((thisFrameTimeStamp: DOMHighResTimeStamp) => {
        lastFrameTimeStamp = thisFrameTimeStamp;
        requestAnimationFrame(moveEgg);
    });

    function moveEgg(thisFrameTimeStamp: DOMHighResTimeStamp) {
        const elapsedMS = thisFrameTimeStamp - lastFrameTimeStamp;
        lastFrameTimeStamp = thisFrameTimeStamp;

        const distanceToTravel = elapsedMS * parseFloat(pixelsPerMS.get());
        current.x += Math.min(distanceToTravel, target.x - current.x);
        current.y += Math.min(distanceToTravel, target.y - current.y);

        egg.style.setProperty("--x", Math.round(current.x) + "px");
        egg.style.setProperty("--y", Math.round(current.y) + "px");

        requestAnimationFrame(moveEgg);
    }
</script>
