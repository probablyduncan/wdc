---
import { Code } from "astro-expressive-code/components";
import Slide from "../components/slide.astro";
---

<Slide prev="index">
    <div id="html-css-code">
        <Code
            lang="html"
            code={`
<img id="egg" alt="my best egg"
    src="egg.webp" draggable="false" />`}
        />
        <Code
            lang="css"
            collapse={["5-8", "11-15"]}
            collapseStyle="collapsible-start"
            code={`
#egg {
    --x: 0; --y: 0;
    transform: translate(var(--x), var(--y));

    position: fixed;
    width: 5rem;
    pointer-events: none;
    user-select: none;
}

@media (prefers-reduced-motion) {
    #egg {
        display: none;
    }
}
    `}
        />
    </div>
    <div id="js-code">
