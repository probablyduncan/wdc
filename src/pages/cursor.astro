        /* max-width: min(50ch, 50vw - 3ch); */
    }

    :global(.expressive-code) {
        &:not(.active) {
            display: none;
        }
    }

    #css :global(.code) {
        /* width: 45ch; */
    }
</style>
<script>
    import { addConstControl } from "../lib/codeBlockHooks";
    import {
        registerClassTransition,
        registerRafTransition,
        withPrevious,
    } from "../lib/slides";
    import { registerTransition } from "../lib/slides";

    const egg = document.getElementById("egg")!;

    const target = { x: 0, y: 0 };
    window.addEventListener("mousemove", (e) => {
        target.x = e.clientX;
        target.y = e.clientY;
    });

    const animationOptions: {
        lerpType:
            | "instant"
            | "current-not-updating"
            | "current-just-bottom-right"
            | "constant-speed-positive-only"
            | "constant-speed"
            | "constant-speed-trig"
            | "basic-half"
            | "half";
    } = {
        lerpType: "instant",
    };

    function animationOptionTransition<
        TKey extends keyof typeof animationOptions,
    >(key: TKey, value: (typeof animationOptions)[TKey]) {
        let prevValue: any;
        registerTransition({
            begin() {
                prevValue = animationOptions[key];
                animationOptions[key] = value;
            },
            revert() {
                animationOptions[key] = prevValue;
            },
        });
    }

    function toggleEggClass(className: string, remove: boolean = false) {
        const beginAction = remove ? "remove" : "add";
        const revertAction = remove ? "add" : "remove";
        registerTransition({
            begin() {
                egg.classList[beginAction](className);
            },
            revert() {
                egg.classList[revertAction](className);
            },
        });
    }

    const pxPerFrameControl = addConstControl(
        "PIXELS_PER_FRAME",
        [-20, -5, -2, -1, 0, 1, 2, 5, 20],
        true,
    );

    const halfLifeBasicControl = addConstControl("LERP_VALUE", [0, 0.005, 0.05, 0.5]);

    const halfLifeControl = addConstControl(
        "HALF_LIFE",
        [0, 5, 20, 50, 100, 200, 500, 1000, 2000],
    );

    const { html, css, ts } = (() => {
        const langs = ["html", "css", "ts"] as const;
        type Lang = (typeof langs)[number];
        type CodeBlockAction = "next" | "show" | "hide";
        return langs.reduce(
            (map, lang) => {
                const wrapperEl = document.getElementById(lang);
                if (!wrapperEl) return map;

                const codeBlockEls = [
                    ...wrapperEl.querySelectorAll<HTMLElement>(
                        ".expressive-code",
                    ),
                ];

                let index = codeBlockEls.findIndex((el) =>
                    el.classList.contains("active"),
                );

                function getCurrent() {
                    if (index > -1 && index < codeBlockEls.length) {
                        return codeBlockEls[index];
                    }
                }

                function toggleCurrent(type: "remove" | "add") {
                    const currentEl = getCurrent();
                    if (!currentEl) return;

                    currentEl.classList[type]("active");

                    // reset scroll and close collapsible sections
                    if (type === "add") {
                        currentEl
                            .querySelector<HTMLPreElement>(`pre`)
                            ?.scrollTo({ behavior: "instant", left: 0 });
                        currentEl
                            .querySelectorAll("details")
                            .forEach((detail) => {
                                detail.open = false;
                            });
                    }
                }

                function isHidden() {
                    if (index > -1 && index < codeBlockEls.length) {
                        return !codeBlockEls[index].classList.contains(
                            "active",
                        );
                    }

                    return false;
                }

                function registerNext() {
                    let hiddenOnBegin = false;
                    registerTransition({
                        begin() {
                            hiddenOnBegin = isHidden();
                            const atEnd = index >= codeBlockEls.length - 1;

                            if (!hiddenOnBegin && !atEnd) {
                                toggleCurrent("remove");
                            }

                            index++;
                            if (!atEnd) {
                                toggleCurrent("add");
                            }
                        },
                        revert() {
                            toggleCurrent("remove");
                            index--;
                            if (!hiddenOnBegin) {
                                toggleCurrent("add");
                            }
                        },
                    });
                }

                function registerHide() {
                    let hiddenOnBegin = false;
                    registerTransition({
                        begin() {
                            hiddenOnBegin = isHidden();
                            toggleCurrent("remove");
                        },
                        revert() {
                            if (!hiddenOnBegin) {
                                toggleCurrent("add");
                            }
                        },
                    });
                }

                function registerShow() {
                    let hiddenOnBegin = false;
                    registerTransition({
                        begin() {
                            hiddenOnBegin = isHidden();
                            toggleCurrent("add");
                        },
                        revert() {
                            if (hiddenOnBegin) {
                                toggleCurrent("remove");
                            }
                        },
                    });
                }

                map[lang] = {
                    hide: registerHide,
                    show: registerShow,
                    next: registerNext,
                    currentElement: getCurrent,
                };

                return map;
            },
            {} as Record<
                Lang,
                Record<CodeBlockAction, () => void> & {
                    currentElement: () => HTMLElement | undefined;
                }
            >,
        );
    })();

    function isEggOverCode() {
        const eggRect = egg.getBoundingClientRect();
        const eggX = eggRect.left + eggRect.width / 2;
        const eggY = eggRect.top + eggRect.height / 2;
        function checkEggOverlap(el: HTMLElement | undefined) {
            if (!el) return false;

            const codeRect = el.getBoundingClientRect();
            return !(
                eggX < codeRect.left ||
                eggX > codeRect.right ||
                eggY < codeRect.top ||
                eggY > codeRect.bottom
            );
        }

        return (
            checkEggOverlap(ts.currentElement()) ||
            checkEggOverlap(css.currentElement()) ||
            checkEggOverlap(html.currentElement())
        );
    }

    const raf = registerRafTransition(
        { current: { x: 0, y: 0 } },
        ({ delta, state: { current } }) => {
            switch (animationOptions.lerpType) {
                case "instant":
                    current.x = target.x;
                    current.y = target.y;
                    break;
                case "current-not-updating":
                    break;
                case "current-just-bottom-right":
                    current.x += pxPerFrameControl.get();
                    current.y += pxPerFrameControl.get();
                    break;
                case "constant-speed-positive-only":
                    current.x = Math.min(
                        target.x,
                        current.x + pxPerFrameControl.get(),
                    );
                    current.y = Math.min(
                        target.y,
                        current.y + pxPerFrameControl.get(),
                    );
                    break;
                case "constant-speed":
                    const distanceX = target.x - current.x;
                    const distanceY = target.y - current.y;
                    current.x +=
                        Math.min(pxPerFrameControl.get(), Math.abs(distanceX)) *
                        Math.sign(distanceX);
                    current.y +=
                        Math.min(pxPerFrameControl.get(), Math.abs(distanceY)) *
                        Math.sign(distanceY);
                    break;
                case "constant-speed-trig":
                    const distanceToTarget = {
                        x: target.x - current.x,
                        y: target.y - current.y,
                    };
                    const angleToTarget = Math.atan2(
                        distanceToTarget.y,
                        distanceToTarget.x,
                    );
                    const distanceToTravel = {
                        x: Math.cos(angleToTarget) * pxPerFrameControl.get(),
                        y: Math.sin(angleToTarget) * pxPerFrameControl.get(),
                    };
                    const distanceToTravelFinalFinalNoEdits = {
                        x: Math.min(
                            Math.abs(distanceToTarget.x),
                            Math.abs(distanceToTravel.x),
                        ),
                        y: Math.min(
                            Math.abs(distanceToTarget.y),
                            Math.abs(distanceToTravel.y),
                        ),
                    };
                    current.x +=
                        distanceToTravelFinalFinalNoEdits.x *
                        Math.sign(distanceToTarget.x);
                    current.y +=
                        distanceToTravelFinalFinalNoEdits.y *
                        Math.sign(distanceToTarget.y);
                    break;
                case "basic-half":
                    current.x += (target.x - current.x) * halfLifeBasicControl.get();
                    current.y += (target.y - current.y) * halfLifeBasicControl.get();
                    break;
                case "half":
                    const lerpValue = Math.min(
                        1,
                        (0.5 * delta) / halfLifeControl.get(),
                    );
                    current.x += (target.x - current.x) * lerpValue;
                    current.y += (target.y - current.y) * lerpValue;
                    break;
            }

            egg.style.setProperty("--x", current.x + "px");
            egg.style.setProperty("--y", current.y + "px");
            egg.style.setProperty("--over-code", isEggOverCode() ? "1" : "0");

            return true;
        },
    );

    // egg appears
    html.next();
    toggleEggClass("nothing");
    withPrevious();

    // add some css
    css.next();

    // oops, add id
    html.next();
    toggleEggClass("sized");
    withPrevious();

    // now try first simple mousemove
    raf.registerStart();
    ts.next();
    withPrevious();
    registerTransition({
        begin: () => {},
        revert() {
            // when we revert before this point, should reset egg pos
            egg.style.removeProperty("--x");
            egg.style.removeProperty("--y");
        },
    });
    withPrevious();
    html.next();
    withPrevious();

    // remove style updates from mousemove
    raf.registerEnd();
    ts.next();
    withPrevious();

    // add moveEgg function
    ts.next();

    for(let i = 0; i < 3; i++) {
        // call moveEgg once, update position once
        ts.next();
        registerTransition({
            begin() {
                egg.style.setProperty("--x", target.x + "px");
                egg.style.setProperty("--y", target.y + "px");
            },
            revert() {}
        });
        withPrevious();
    }

    // make recursive, start loop
    ts.next();
    raf.registerStart();
    withPrevious();

    // z index, move egg to front
    css.next();
    ts.next();
    withPrevious();
    toggleEggClass("front");
    withPrevious();

    // pointer events, draggable, etc
    html.next();
    css.next();
    withPrevious();
    toggleEggClass("no-pointer");
    withPrevious();
    registerTransition({
        begin() {
            egg.draggable = false;
        },
        revert() {
            egg.draggable = true;
        },
    });
    withPrevious();

    // center on cursor using ts
    ts.next();
    toggleEggClass("center");
    withPrevious();
    css.next();
    withPrevious();
    html.next();
    withPrevious();

    // but we want to use css props
    css.next();

    // add css transform, set props in ts
    css.next();
    ts.next();
    withPrevious();

    // or use variables with defaults?
    css.next();
    ts.next();
    withPrevious();

    css.next();

    // show wcaglette popup
    registerClassTransition("#wcaglette", "active");

    // add reduced motion css
    toggleEggClass("no-motion");
    css.next();
    withPrevious();

    // hide wcaglette popup, condense css
    registerClassTransition("#wcaglette", "active", "remove");
    css.next();
    withPrevious();

    // so now we get to lerping! what fun

    // add current, but we're not updating it yet
    animationOptionTransition("lerpType", "current-not-updating");
    ts.next();
    withPrevious();

    // collapse stuff on top
    ts.next();

    // go towards bottom right
    animationOptionTransition("lerpType", "current-just-bottom-right");
    ts.next();
    withPrevious();
    registerTransition({
        begin() {
            pxPerFrameControl.show();
        },
        revert() {
            pxPerFrameControl.hide();
            pxPerFrameControl.reset();
        },
    });
    withPrevious();

    // go towards current every frame, but only positive
    animationOptionTransition("lerpType", "constant-speed-positive-only");
    ts.next();
    withPrevious();

    ts.next();

    // go towards current every frame
    animationOptionTransition("lerpType", "constant-speed");
    ts.next();
    withPrevious();
    
    // build up trig
    ts.next();
    ts.next();
    ts.next();
    animationOptionTransition("lerpType", "constant-speed-trig");
    withPrevious();

    // but this is kind of boring anyway, can we do something more interesting?
    // if we lerp proportionally it's a lot easier, we can do it per axis

    ts.next();

    registerClassTransition("#zeno", "active");
    registerClassTransition("#dichotomy", "active");

    registerClassTransition("#zeno", "active", "remove");
    registerClassTransition("#dichotomy", "active", "remove");
    withPrevious();

    ts.next();
    animationOptionTransition("lerpType", "basic-half");
    withPrevious();

    ts.next();

    // should we track and values using trackNumberVariable?

    // so we add fps counter
    // show how animation speed changes

    // how do we solve this problem?
    // i've been keeping something from you
    // unlike your neighbor, requestAnimationFrame gives you the time of day
    // the callback has an argument. I'm convinced!
    // calculate delta
    // HALF_LIFE instead of some random number
    // show FPS changes with new delta-based lerping

