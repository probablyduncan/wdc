`}
        />


    </div>


</Slide>
<style>
    #egg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        user-select: none;
        z-index: 99999999999;

        @media (prefers-reduced-motion: reduce) {
            display: none;
        }

        width: 5rem;

        --x: 0px;
        --y: 0px;
        transform: translate(calc(var(--x) - 50%), calc(var(--y) - 50%));

        transition: opacity 0.4s;
    }

    #html-css-code {
        position: fixed;
        top: 2ch;
        right: 2ch;
        display: flex;
        flex-flow: column;
        gap: 2ch;
    }

    #js-code {
        position: fixed;
        top: 2ch;
        left: 2ch;
    }

    :global(body:has(.expressive-code:hover)) #egg {
        opacity: 0.4;
    }
</style>
<script>
    import { addConstControl } from "../lib/addConstControl";
    import { LerpController } from "../lib/interpolationController";

    const egg = document.getElementById("egg")!;
    const x = new LerpController();
    const y = new LerpController();

    window.addEventListener("mousemove", ({ clientX, clientY }) => {
        x.target = clientX;
        y.target = clientY;
    });

    const halfLifeControl = addConstControl("HALF_LIFE", [
        "0",
        "5",
        "20",
        "50",
        "100",
        "200",
        "500",
        "1000",
        "2000",
    ]);

    halfLifeControl.listen((value) => {
        const num = parseFloat(value);
        x.halfLife = num;
        y.halfLife = num;
    });

    let prev: DOMHighResTimeStamp;
    requestAnimationFrame((thisFrameTimeStamp: DOMHighResTimeStamp) => {
        prev = thisFrameTimeStamp;
        // requestAnimationFrame(moveEgg);
    });

    function moveEgg(time: DOMHighResTimeStamp) {
        const delta = time - prev;
        prev = time;
        egg.style.setProperty("--x", x.step(delta).toFixed() + "px");
        egg.style.setProperty("--y", y.step(delta).toFixed() + "px");
        requestAnimationFrame(moveEgg);
    }
</script>
