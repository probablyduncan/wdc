---
import Controls from "../components/controls.astro";
import Control from "../components/control.astro";
---

<!doctype html>
<html lang="en">
    <head></head>
    <body>
        <canvas id="canvas"></canvas>
        <Controls>
            <Control name="legs" type="range" min={2} max={16} value={8} />
        </Controls>
    </body>
</html>

<style>
    body {
        overflow: clip;
        width: 100vw;
        height: 100vh;
    }
    #canvas {
        position: fixed;
        inset: 0;
    }

    :global(.name-tag) {
        background-color: tomato;
        color: white;
        border-radius: 4px;
        padding: 0.25em 1ch;
        font-family: "Recursive";
        font-size: 0.5rem;
        position: fixed;
        top: 0;
        left: 0;

        --x: 0px;
        --y: 0px;
        --r: 0rad;
        transform: translate(var(--x), var(--y)) rotate(var(--r));
    }
</style>

<script>
    import AnimationFrameController from "../lib/animationFrameController";
    import { LerpController } from "../lib/interpolationController";
    import { SpiderController } from "../lib/spider";

    const canvas = document.getElementById("canvas") as HTMLCanvasElement;
    const context = canvas.getContext("2d")!;

    function scaleCanvasToWindow(
        canvas: HTMLCanvasElement,
        context: CanvasRenderingContext2D,
    ) {
        const dpr = window.devicePixelRatio || 1;
        canvas.style.width = window.innerWidth + "px";
        canvas.style.height = window.innerHeight + "px";
        canvas.width = window.innerWidth * dpr;
        canvas.height = window.innerHeight * dpr;
        context.setTransform(1, 0, 0, 1, 0, 0);
        context.scale(dpr, dpr);
    }

    function clearCanvas(
        canvas: HTMLCanvasElement,
        context: CanvasRenderingContext2D,
    ) {
        context.clearRect(0, 0, canvas.width, canvas.height);
    }

    const spider = new SpiderController();
    const label = document.createElement("div");
    label.innerText = "https://da-bomb.com";
    label.classList.add("name-tag");
    document.body.appendChild(label);

    const labelX = new LerpController();
    const labelY = new LerpController();
    const labelAngle = label.clientHeight > label.clientWidth ? -1 : 1;

    const animation = new AnimationFrameController(({ deltaMS }) => {
        spider.step(deltaMS);

        clearCanvas(canvas, context);
        spider.draw(context);

        labelX.step(deltaMS);
        labelY.step(deltaMS);

        // label angle
        const pullAngle =
            labelAngle *
            Math.abs(
                Math.atan2(
                    labelY.current - labelY.target,
                    labelX.target - labelY.current,
                ),
            );

        label.style.setProperty("--x", labelX.current + "px");
        label.style.setProperty("--y", labelY.current + "px");
        label.style.setProperty("--r", pullAngle + "rad");

        return true;
    });

    window.addEventListener("resize", () =>
        scaleCanvasToWindow(canvas, context),
    );

    window.addEventListener("DOMContentLoaded", () => {
        animation.playIfPaused();
    });

    document.addEventListener("mousemove", ({ clientX, clientY }) => {
        spider.target[0] = clientX;
        spider.target[1] = clientY;

        // if it's to the right of the spider, stay right
        // if to the left, stay left

        // label is to right of cursor
        if (clientX < labelX.current - 24) {
            labelX.target = clientX + 24;
        }
        // label is to left of cursor
        else if (clientX > labelX.current + label.clientWidth + 24) {
            labelX.target = clientX - 24 - label.clientWidth;
        }

        if (clientY < labelY.current - 12) {
            labelY.target = clientY + 12;
        } else if (clientY > labelY.current + label.clientHeight + 12) {
            labelY.target = clientY - 12 - label.clientHeight;
        }
    });

    scaleCanvasToWindow(canvas, context);
    animation.playIfPaused();
</script>
