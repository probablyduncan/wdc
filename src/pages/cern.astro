---
// import { getPageInfo, getPageName } from "../lib/slides.server";

// https://info.cern.ch/hypertext/WWW/TheProject.html
export const nextPage = "alternatives";
export const transitions = ["center", "inter", "gradient", "heading", "subway"];
---

<!doctype html>
<html>
    <head>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <img id="subway" src="/images/subway.gif" draggable="false" />
        <main>
            <div id="noise"></div>

            <header>
                <title>The World Wide Web project</title>
            </header>

            <h1>
                World Wide Web <span class="slink-in">(<b>AI-Native</b>)</span>
            </h1>
            The WorldWideWeb (W3) is a<span class="slink-in"
                >n <b>AI-Native</b></span
            > wide-area <a>hypermedia</a> information retrieval initiative aiming
            to give universal access to a large universe of documents.
            <p>
                Everything there is online about W3 is linked directly or
                indirectly to this document, including an <span class="slink-in"
                    ><b>LLM</b>-friendly
                </span>
                <a>executive summary</a> of the project, <a>Mailing lists</a>, <a
                    >Policy</a
                >, November's <a>W3 news</a>, <a>Frequently Asked Questions</a>.
            </p>
            <dl>
                <dt>
                    <a>What's out there?</a>
                </dt><dd>
                    Pointers to the world's online information, <a>subjects</a>, <a
                        >W3 servers</a
                    >, etc.
                </dd><dt>
                    <a>Help</a>
                </dt><dd>on the browser you are using</dd><dt>
                    <a>Software Products</a>
                </dt><dd>
                    A list of W3 project components and their current state.
                    (e.g. <a>Line Mode</a>, X11 <a>Viola</a>, <a>NeXTStep</a>, <a
                        >Servers</a
                    >, <a>Tools</a>, <a>Mail robot</a>, <a>Library</a>)
                </dd><dt>
                    <a>Technical</a>
                </dt><dd>
                    Details of protocols, formats, program internals etc
                </dd><dt>
                    <a>Bibliography</a>
                </dt><dd>Paper documentation on W3 and references.</dd><dt>
                    <a>People</a>
                </dt><dd>A list of some people involved in the project.</dd><dt>
                    <a>History</a>
                </dt><dd>A summary of the history of the project.</dd><dt
                    style=""
                >
                    <a>How can I help</a> ?
                </dt><dd>If you would like to support the web..</dd><dt>
                    <a>Getting code</a>
                </dt><dd>
                    Getting the code by <a>anonymous FTP</a>, etc.
                </dd>
            </dl>
        </main>
    </body>
</html>
<style>
    body {
        display: grid;
        grid-template-columns: auto 1fr;
        font-family: "Times New Roman", Times, serif;
    }

    body.center {
        text-align: center;
        margin: 0;
    }

    body.inter {
        font-optical-sizing: auto;
        font-family: "Inter";
    }

    #subway {
        grid-column: 1;
        width: 0;
        height: 100vh;
        pointer-events: none;
        user-select: none;
    }

    main {
        grid-column: 2;
    }

    main.gradient {
        background-image: url("/images/gradient.svg");
        background-size: cover;
        background-position: center;
        color: white;
        a {
            color: rgb(255, 219, 219);
        }
    }

    h1.gradient {
        background: linear-gradient(
            100deg,
            #fff 10%,
            #3ddcff 40%,
            #ff5fb0 65%,
            #ffcf5c 90%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        font-size: 10vw;
    }

    a {
        text-decoration: underline;
        color: blue;
        cursor: pointer;

        display: inline-block;
        --x: 0px;
        --y: 0px;
        transform: translate(var(--x), var(--y));

        user-select: none;
        -webkit-user-select: none;
    }

    .slink-in:not(.slunk) {
        display: none;
    }
</style>
<script>
    import AnimationFrameController from "../lib/animationFrameController";
    import { SpringController } from "../lib/interpolationController";
    import {
        registerClassTransition,
        registerTransition,
        registerWaapiTransition,
    } from "../lib/slides";

    function getAnimationTransition(
        id: string,
        ...animateParams: Parameters<HTMLElement["animate"]>
    ) {
        let animation: Animation | undefined = undefined;
        return {
            begin() {
                if (animation) {
                    return;
                }
                animation = document
                    .getElementById(id)
                    ?.animate(...animateParams);
            },
            revert() {
                if (animation) {
                    animation.cancel();
                    animation = undefined;
                }
            },
        };
    }

    registerClassTransition("body", "center");
    registerClassTransition("body", "inter");
    registerClassTransition("main", "gradient");
    registerClassTransition("h1", "gradient");

    registerWaapiTransition(
        "#subway",
        [{ width: 0 }, { width: (100 * 124) / 225 + "vh" }],
        {
            duration: 1000,
            fill: "forwards",
            easing: "linear(0, 0.029 1.3%, 0.119 2.8%, 0.659 8.7%, 0.871 11.6%, 1.009 14.6%, 1.052 16.2%, 1.078 17.9%, 1.088 19.7%, 1.085 21.7%, 1.014 31.4%, 0.993 38%, 1.001 57.6%, 1)",
        },
    );

    function showSlinks() {
        const els = [...document.querySelectorAll<HTMLElement>(".slink-in")];
        els.forEach((el, i) => {
            const text = [...el.innerText];
            el.innerText = "";
            el.classList.add("slunk");
            let intervalId = setInterval(() => {
                const char = text.shift();
                if (char) {
                    el.innerText += char;
                } else {
                    clearInterval(intervalId);
                }
            }, 20);
        });
    }
    document.addEventListener("keypress", ({ key }) => {
        if (key === " ") {
            showSlinks();
        } else if (key === "i") {
            document.body.classList.toggle("inter");
        }
    });

    function initGrabbableLinks() {
        document.querySelectorAll<HTMLElement>("a").forEach((el) => {
            const x = new SpringController();
            const y = new SpringController();
            let grabPos: [number, number] | undefined = undefined;

            function onMouseDown({ clientX, clientY }: MouseEvent) {
                grabPos = [clientX - x.current, clientY - y.current];
                window.addEventListener("mousemove", onMouseMove);
                window.addEventListener("mouseup", onMouseUp, { once: true });
                animation.playIfPaused();
                // x.options.stiffness = y.options.stiffness = 100;
                // x.options.mass = y.options.mass = 2;
            }

            function onMouseMove({ clientX, clientY }: MouseEvent) {
                if (grabPos) {
                    x.target = clientX - grabPos[0];
                    y.target = clientY - grabPos[1];
                }
            }

            function onMouseUp() {
                window.removeEventListener("mousemove", onMouseUp);
                grabPos = undefined;
                // x.options.stiffness = y.options.stiffness = 400;
                // x.options.mass = y.options.mass = 1;
                // x.target = 0;
                // y.target = 0;
            }

            el.addEventListener("mousedown", onMouseDown);

            const animation = new AnimationFrameController((deltaMS) => {
                x.step(deltaMS);
                y.step(deltaMS);
                el.style.setProperty("--x", x.current + "px");
                el.style.setProperty("--y", y.current + "px");

                // keep animating if grabbing or returning to pos
                return (
                    grabPos !== undefined ||
                    Math.abs(x.velocity) > 0.5 ||
                    Math.abs(x.velocity) > 0.5 ||
                    Math.abs(x.current) > 1 ||
                    Math.abs(y.current) > 1
                );
            });
        });
    }

    // function wrapWords(element: ChildNode) {
    //     Array.from(element.childNodes).forEach((node) => {
    //         if (node.nodeType === 3) {
    //             const text = node.textContent ?? "";
    //             const fragment = document.createDocumentFragment();

    //             text.split(" ").forEach((word, i) => {
    //                 const span = document.createElement("span");
    //                 span.classList.add("word");
    //                 if (i != 0) {
    //                     span.textContent += " ";
    //                 }
    //                 span.textContent += word;
    //                 fragment.appendChild(span);
    //             });

    //             node.parentNode!.replaceChild(fragment, node);
    //         } else if (node.nodeType === 1) {
    //             wrapWords(node);
    //         }
    //     });
    // }

    const colors = [
        "green",
        "blue",
        "yellow",
        "orange",
        "red",
        "tomato",
        "purple",
    ];

    document.addEventListener("DOMContentLoaded", initGrabbableLinks);
</script>
